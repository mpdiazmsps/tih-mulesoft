<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
		http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd">

	<apikit:config name="sapi-crm-config"
		api="resource::9885f017-0660-4c80-a27f-eb006d124bd8:sapi-crm:1.0.1:raml:zip:sapi-crm.raml"
		outboundHeadersMapName="outboundHeaders"
		httpStatusVarName="httpStatus"
		doc:name="APIkit Router config"
		doc:description="Validates each request against the sapi-crm RAML and routes it to its interface flow"/>

	<flow name="sapi-crm-main"
		doc:name="sapi-crm-main"
		doc:description="HTTP entry point. Errors are handled by the global error handler">
		<http:listener config-ref="sapi-crm-httpListenerConfig" path="${http.listener.basePath}/*"
			doc:name="Listener"
			doc:description="Receives requests on the API base path">
			<http:response statusCode="#[vars.httpStatus default 200]">
				<http:headers>#[vars.outboundHeaders default {}]</http:headers>
			</http:response>
			<http:error-response statusCode="#[vars.httpStatus default 500]">
				<http:body>#[payload]</http:body>
				<http:headers>#[vars.outboundHeaders default {}]</http:headers>
			</http:error-response>
		</http:listener>
		<apikit:router config-ref="sapi-crm-config"
			doc:name="APIkit Router"
			doc:description="Routes the request to the interface flow matching the RAML method and resource"/>
	</flow>

	<!-- Interface flows with the APIkit scaffolding names: they only delegate to the implementation. Do not rename. -->

	<flow name="get:\contacts:sapi-crm-config"
		doc:name="get:\contacts"
		doc:description="List or search contacts (ids, email/phone or page)">
		<flow-ref name="contacts-list-flow" doc:name="contacts-list-flow"
			doc:description="Delegates to the contact listing and search"/>
	</flow>

	<flow name="post:\contacts:application\json:sapi-crm-config"
		doc:name="post:\contacts"
		doc:description="Create a contact">
		<flow-ref name="contacts-create-flow" doc:name="contacts-create-flow"
			doc:description="Delegates to the contact creation"/>
	</flow>

	<flow name="get:\contacts\(id):sapi-crm-config"
		doc:name="get:\contacts\(id)"
		doc:description="Get one contact">
		<flow-ref name="contacts-get-flow" doc:name="contacts-get-flow"
			doc:description="Delegates to the contact lookup"/>
	</flow>

</mule>

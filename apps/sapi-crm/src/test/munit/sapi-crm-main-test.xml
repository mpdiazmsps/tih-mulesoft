<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:os="http://www.mulesoft.org/schema/mule/os"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
	xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd
		http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

	<!-- End-to-end HTTP tests: real listener (8094), APIkit with the Exchange contract, interface flows,
	     global error handler and response codes. Salesforce is mocked. -->
	<munit:config name="sapi-crm-main-test.xml"/>

	<!-- MUnit initializes lazily: APIkit needs the interface flows and resilience-call needs the Salesforce flows. -->
	<munit:before-suite name="sapi-crm-main-warm-up">
		<choice>
			<when expression="#[false]">
				<flow-ref name="get:\contacts:sapi-crm-config"/>
				<flow-ref name="post:\contacts:application\json:sapi-crm-config"/>
				<flow-ref name="get:\contacts\(id):sapi-crm-config"/>
				<flow-ref name="crm-query-subflow"/>
				<flow-ref name="crm-create-subflow"/>
			</when>
		</choice>
	</munit:before-suite>

	<http:request-config name="test-api-client" doc:name="HTTP Request configuration">
		<http:request-connection host="localhost" port="8094"/>
	</http:request-config>

	<!-- Every test starts with the crm circuit closed: failures of one test must not leak into the next. -->
	<munit:before-test name="sapi-crm-main-reset-circuit" description="Closes the crm circuit before each test">
		<try>
			<os:remove key="crm" objectStore="rs-circuit-store"/>
			<error-handler>
				<on-error-continue type="ANY" logException="false"/>
			</error-handler>
		</try>
	</munit:before-test>

	<munit:test name="api_getContactsByIds_returns200" description="GET /contacts?ids= returns the four customers">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="sapi-crm-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when processor="salesforce:query">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="salesforce-query-contacts"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/java --- [ { Id: '003Hs00000ANGELAAA', Name: 'Ferretería Angelópolis', Email: 'compras@angelopolis.ejemplo.mx', Phone: '+522221234567', Segmento__c: 'Regular', MailingStreet: 'Blvd. Atlixcáyotl 500', MailingCity: 'Puebla', MailingState: null, MailingPostalCode: '72830' }, { Id: '003Hs00000CUMBRAAA', Name: 'Constructora Cumbres', Email: 'compras@cumbres.ejemplo.mx', Phone: '+528181234567', Segmento__c: 'Estratégico', MailingStreet: 'Av. Constitución 100', MailingCity: 'Monterrey', MailingState: null, MailingPostalCode: '64000' }, { Id: '003Hs00000TAPATAAA', Name: 'Grupo Hotelero Tapatío', Email: 'compras@tapatio.ejemplo.mx', Phone: '+523331234567', Segmento__c: 'Estratégico', MailingStreet: 'Av. Vallarta 2000', MailingCity: 'Guadalajara', MailingState: null, MailingPostalCode: '44100' }, { Id: '003Hs00000COYOAAAA', Name: 'Papelería Coyoacán', Email: 'compras@coyoacan.ejemplo.mx', Phone: '+525551234567', Segmento__c: 'Regular', MailingStreet: 'Av. Miguel Ángel de Quevedo 300', MailingCity: 'Ciudad de México', MailingState: null, MailingPostalCode: '04000' } ]]" mediaType="application/java"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<http:request method="GET" config-ref="test-api-client" path="/api/v1/crm/contacts?ids=003Hs00000CUMBRAAA,003Hs00000TAPATAAA,003Hs00000ANGELAAA,003Hs00000COYOAAAA">
				<http:headers><![CDATA[#[{ client_id: 'test-id', client_secret: 'test-secret' }]]]></http:headers>
				<http:response-validator><http:success-status-code-validator values="0..599"/></http:response-validator>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- attributes.statusCode]" is="#[MunitTools::equalTo(200)]"/>
			<munit-tools:assert-that expression="#[output application/java --- sizeOf(payload)]" is="#[MunitTools::equalTo(4)]"/>
		</munit:validation>
	</munit:test>

	<munit:test name="api_getContact_unknown_returns404" description="An unknown Id returns 404 CONTACT_NOT_FOUND">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="sapi-crm-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when processor="salesforce:query">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="salesforce-query-contacts"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/java --- []]" mediaType="application/java"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<http:request method="GET" config-ref="test-api-client" path="/api/v1/crm/contacts/003Hs00000NOEXIAAA">
				<http:headers><![CDATA[#[{ client_id: 'test-id', client_secret: 'test-secret' }]]]></http:headers>
				<http:response-validator><http:success-status-code-validator values="0..599"/></http:response-validator>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- attributes.statusCode]" is="#[MunitTools::equalTo(404)]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload.code]" is="#[MunitTools::equalTo('CONTACT_NOT_FOUND')]"/>
		</munit:validation>
	</munit:test>

	<munit:test name="api_postContact_duplicate_returns409" description="An existing email returns 409 CONTACT_ALREADY_EXISTS">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="sapi-crm-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when processor="salesforce:create">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="salesforce-create-contact"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/java --- { successful: false, items: [ { successful: false, id: null, message: 'Use one of these records?', payload: { success: false, errors: [ { statusCode: 'DUPLICATES_DETECTED', message: 'Use one of these records?', fields: [] } ] } } ] }]" mediaType="application/java"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<http:request method="POST" config-ref="test-api-client" path="/api/v1/crm/contacts">
				<http:body><![CDATA[#[output application/json --- { name: 'Constructora Cumbres 2', email: 'compras@cumbres.ejemplo.mx' }]]]></http:body>
				<http:headers><![CDATA[#[{ client_id: 'test-id', client_secret: 'test-secret', 'Content-Type': 'application/json' }]]]></http:headers>
				<http:response-validator><http:success-status-code-validator values="0..599"/></http:response-validator>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- attributes.statusCode]" is="#[MunitTools::equalTo(409)]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload.code]" is="#[MunitTools::equalTo('CONTACT_ALREADY_EXISTS')]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload.retryable]" is="#[MunitTools::equalTo(false)]"/>
		</munit:validation>
	</munit:test>

	<munit:test name="api_getContact_invalidId_returns400" description="An Id that is not 18 characters breaks the contract and returns 400">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="sapi-crm-main"/>
		</munit:enable-flow-sources>
		<munit:execution>
			<http:request method="GET" config-ref="test-api-client" path="/api/v1/crm/contacts/123">
				<http:headers><![CDATA[#[{ client_id: 'test-id', client_secret: 'test-secret' }]]]></http:headers>
				<http:response-validator><http:success-status-code-validator values="0..599"/></http:response-validator>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- attributes.statusCode]" is="#[MunitTools::equalTo(400)]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload.code]" is="#[MunitTools::equalTo('VALIDATION_ERROR')]"/>
		</munit:validation>
	</munit:test>

	<munit:test name="api_salesforceDown_returns503WithRetryAfter" description="With Salesforce down it returns a retryable 503 with Retry-After">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="sapi-crm-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when processor="salesforce:query">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="salesforce-query-contacts"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="SALESFORCE:TIMEOUT"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<http:request method="GET" config-ref="test-api-client" path="/api/v1/crm/contacts/003Hs00000CUMBRAAA">
				<http:headers><![CDATA[#[{ client_id: 'test-id', client_secret: 'test-secret' }]]]></http:headers>
				<http:response-validator><http:success-status-code-validator values="0..599"/></http:response-validator>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- attributes.statusCode]" is="#[MunitTools::equalTo(503)]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload.code]" is="#[MunitTools::equalTo('SERVICE_UNAVAILABLE')]"/>
			<munit-tools:assert-that expression="#[output application/java --- attributes.headers.'retry-after']" is="#[MunitTools::equalTo('30')]"/>
		</munit:validation>
	</munit:test>

</mule>

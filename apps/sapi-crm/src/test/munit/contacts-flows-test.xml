	<munit:test name="postContact_duplicatesDetected_returns409ContactAlreadyExists" description="The duplicate rule blocks an existing email (DUPLICATES_DETECTED): CONTACT_ALREADY_EXISTS and no retry (D22)">
		<munit:behavior>
			<munit-tools:mock-when processor="salesforce:create">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="salesforce-create-contact"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/java --- { successful: false, items: [ { successful: false, id: null, message: 'Use one of these records?', payload: { success: false, errors: [ { statusCode: 'DUPLICATES_DETECTED', message: 'Use one of these records?', fields: [] } ] } } ] }]" mediaType="application/java"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:payload value="#[output application/json --- { name: 'Constructora Cumbres 2', email: 'compras@cumbres.ejemplo.mx' }]" mediaType="application/json"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<try>
				<flow-ref name="contacts-create-flow"/>
				<error-handler>
					<on-error-continue type="APP:CONTACT_ALREADY_EXISTS" logException="false">
						<set-variable variableName="caught" value="#[output application/java --- error.errorType.identifier]"/>
					</on-error-continue>
				</error-handler>
			</try>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- vars.caught]" is="#[MunitTools::equalTo('CONTACT_ALREADY_EXISTS')]"/>
			<munit-tools:verify-call processor="salesforce:create" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="salesforce-create-contact"/>
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>


	<!-- Per-flow tests for sapi-crm (task 14). Salesforce is mocked by the doc:name of each connector operation.
	     Generated by a script; the data comes from the demo script (data/scenario.json). -->
	<munit:config name="contacts-flows-test.xml"/>

	<!-- resilience-call reaches the Salesforce flows through a dynamic flow-ref: MUnit needs a static reference. -->
	<munit:before-suite name="contacts-flows-static-references" description="Static references to the Salesforce read and write flows">
		<choice>
			<when expression="#[false]">
				<flow-ref name="crm-query-subflow"/>
				<flow-ref name="crm-create-subflow"/>
			</when>
		</choice>
	</munit:before-suite>

	<!-- Every test starts with the crm circuit closed: failures of one test must not leak into the next. -->
	<munit:before-test name="contacts-flows-reset-circuit" description="Closes the crm circuit before each test">
		<try>
			<os:remove key="crm" objectStore="rs-circuit-store"/>
			<error-handler>
				<on-error-continue type="ANY" logException="false"/>
			</error-handler>
		</try>
	</munit:before-test>

	<munit:test name="getContactsByIds_fourIds_singleQuery" description="Four ids are read in one single SOQL query with IN, never one by one">
		<munit:behavior>
			<munit-tools:mock-when processor="salesforce:query">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="salesforce-query-contacts"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/java --- [ { Id: '003Hs00000ANGELAAA', Name: 'Ferretería Angelópolis', Email: 'compras@angelopolis.ejemplo.mx', Phone: '+522221234567', Segmento__c: 'Regular', MailingStreet: 'Blvd. Atlixcáyotl 500', MailingCity: 'Puebla', MailingState: null, MailingPostalCode: '72830' }, { Id: '003Hs00000CUMBRAAA', Name: 'Constructora Cumbres', Email: 'compras@cumbres.ejemplo.mx', Phone: '+528181234567', Segmento__c: 'Estratégico', MailingStreet: 'Av. Constitución 100', MailingCity: 'Monterrey', MailingState: null, MailingPostalCode: '64000' }, { Id: '003Hs00000TAPATAAA', Name: 'Grupo Hotelero Tapatío', Email: 'compras@tapatio.ejemplo.mx', Phone: '+523331234567', Segmento__c: 'Estratégico', MailingStreet: 'Av. Vallarta 2000', MailingCity: 'Guadalajara', MailingState: null, MailingPostalCode: '44100' }, { Id: '003Hs00000COYOAAAA', Name: 'Papelería Coyoacán', Email: 'compras@coyoacan.ejemplo.mx', Phone: '+525551234567', Segmento__c: 'Regular', MailingStreet: 'Av. Miguel Ángel de Quevedo 300', MailingCity: 'Ciudad de México', MailingState: null, MailingPostalCode: '04000' } ]]" mediaType="application/java"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:attributes value="#[{ queryParams: { ids: '003Hs00000CUMBRAAA,003Hs00000TAPATAAA,003Hs00000ANGELAAA,003Hs00000COYOAAAA' } }]"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="contacts-list-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- sizeOf(payload)]" is="#[MunitTools::equalTo(4)]"/>
			<munit-tools:verify-call processor="salesforce:query" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="salesforce-query-contacts"/>
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
			<munit-tools:assert-that expression="#[output application/java --- vars.listQuery.soql contains &quot;'003Hs00000CUMBRAAA'&quot;]" is="#[MunitTools::equalTo(true)]"/>
			<munit-tools:assert-that expression="#[output application/java --- vars.listQuery.soql contains &quot;'003Hs00000TAPATAAA'&quot;]" is="#[MunitTools::equalTo(true)]"/>
			<munit-tools:assert-that expression="#[output application/java --- vars.listQuery.soql contains &quot;'003Hs00000ANGELAAA'&quot;]" is="#[MunitTools::equalTo(true)]"/>
			<munit-tools:assert-that expression="#[output application/java --- vars.listQuery.soql contains &quot;'003Hs00000COYOAAAA'&quot;]" is="#[MunitTools::equalTo(true)]"/>
			<munit-tools:assert-that expression="#[output application/java --- vars.listQuery.soql contains 'WHERE Id IN (']" is="#[MunitTools::equalTo(true)]"/>
		</munit:validation>
	</munit:test>

	<munit:test name="mapsSegmentAndCity" description="Segmento__c Estratégico and Regular become STRATEGIC and REGULAR; the address city comes from MailingCity">
		<munit:behavior>
			<munit-tools:mock-when processor="salesforce:query">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="salesforce-query-contacts"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/java --- [ { Id: '003Hs00000CUMBRAAA', Name: 'Constructora Cumbres', Email: 'compras@cumbres.ejemplo.mx', Phone: '+528181234567', Segmento__c: 'Estratégico', MailingStreet: 'Av. Constitución 100', MailingCity: 'Monterrey', MailingState: null, MailingPostalCode: '64000' }, { Id: '003Hs00000ANGELAAA', Name: 'Ferretería Angelópolis', Email: 'compras@angelopolis.ejemplo.mx', Phone: '+522221234567', Segmento__c: 'Regular', MailingStreet: 'Blvd. Atlixcáyotl 500', MailingCity: 'Puebla', MailingState: null, MailingPostalCode: '72830' }, { Id: '003Hs00000SINCDAAA', Name: 'Sin dirección', Email: null, Phone: '+525550000000', Segmento__c: null, MailingStreet: null, MailingCity: null, MailingState: null, MailingPostalCode: null } ]]" mediaType="application/java"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:attributes value="#[{ queryParams: { page: 1, size: 20 } }]"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="contacts-list-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- payload[0].segment]" is="#[MunitTools::equalTo('STRATEGIC')]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload[0].address.city]" is="#[MunitTools::equalTo('Monterrey')]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload[0].address.postalCode]" is="#[MunitTools::equalTo('64000')]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload[1].segment]" is="#[MunitTools::equalTo('REGULAR')]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload[1].name]" is="#[MunitTools::equalTo('Ferretería Angelópolis')]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload[2].segment]" is="#[MunitTools::equalTo('REGULAR')]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload[2].address]" is="#[MunitTools::equalTo(null)]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload[2].email]" is="#[MunitTools::equalTo(null)]"/>
			<munit-tools:assert-that expression="#[output application/java --- vars.listQuery.soql endsWith 'ORDER BY Name LIMIT 20 OFFSET 0']" is="#[MunitTools::equalTo(true)]"/>
		</munit:validation>
	</munit:test>


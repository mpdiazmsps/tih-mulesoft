	<munit:test name="salesforceDown_returns503RetryableUnder3s" description="A Salesforce timeout answers CRM_UNAVAILABLE (503) at once: a timeout is not retried (D9)">
		<munit:behavior>
			<munit-tools:mock-when processor="salesforce:query">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="salesforce-query-contacts"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="SALESFORCE:TIMEOUT"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:attributes value="#[{ queryParams: { ids: '003Hs00000CUMBRAAA' } }]"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<set-variable variableName="t0" value="#[output application/java --- now() as Number {unit: 'milliseconds'}]"/>
			<try>
				<flow-ref name="contacts-list-flow"/>
				<error-handler>
					<on-error-continue type="APP:CRM_UNAVAILABLE" logException="false">
						<set-variable variableName="caught" value="#[output application/java --- error.description]"/>
					</on-error-continue>
				</error-handler>
			</try>
			<set-variable variableName="elapsed" value="#[output application/java --- (now() as Number {unit: 'milliseconds'}) - vars.t0]"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- vars.caught]" is="#[MunitTools::equalTo('Salesforce is unavailable (TIMEOUT)')]"/>
			<munit-tools:verify-call processor="salesforce:query" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="salesforce-query-contacts"/>
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
			<munit-tools:assert-that expression="#[vars.elapsed]" is="#[MunitTools::lessThan(3000)]"/>
		</munit:validation>
	</munit:test>


<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:os="http://www.mulesoft.org/schema/mule/os"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
	xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd
		http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

	<!-- End-to-end HTTP tests: real listener (8083), APIkit with the Exchange contract, interface flows,
	     global error handler and response codes. Downstream APIs and RabbitMQ are mocked. -->
	<munit:config name="papi-orders-main-test.xml"/>

	<!-- MUnit initializes lazily and APIkit builds its routes from the flows already initialized. -->
	<munit:before-suite name="papi-orders-main-warm-up">
		<choice>
			<when expression="#[false]">
				<flow-ref name="get:\products:papi-orders-config"/>
				<flow-ref name="get:\orders:papi-orders-config"/>
				<flow-ref name="post:\orders:application\json:papi-orders-config"/>
				<flow-ref name="post:\orders\process:papi-orders-config"/>
			</when>
		</choice>
	</munit:before-suite>

	<http:request-config name="test-api-client" doc:name="HTTP Request configuration">
		<http:request-connection host="localhost" port="8083"/>
	</http:request-config>

	<!-- Every test starts with the cycle lock free. -->
	<munit:before-test name="papi-orders-main-free-lock" description="Releases the cycle lock and clears the quote backoff before each test">
		<try>
			<os:remove key="cycle" objectStore="cycle-lock-store"/>
			<error-handler>
				<on-error-continue type="ANY" logException="false"/>
			</error-handler>
		</try>
		<os:clear objectStore="quote-backoff-store"/>
	</munit:before-test>

	<munit:test name="api_postOrder_returns201" description="POST /orders returns 201 with the order RECEIVED">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="papi-orders-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-validate-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- { id: '003Hs00000CUMBRAAA', name: 'Constructora Cumbres', email: 'compras@cumbres.ejemplo.mx', segment: 'STRATEGIC', address: { street: 'Av. Constitución 100', city: 'Monterrey', postalCode: '64000' } }]" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 200, headers: { 'content-type': 'application/json' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-create-order"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- { orderId: '10000000-0000-4000-8000-000000009001', customerId: '003Hs00000CUMBRAAA', status: 'RECEIVED', currency: 'MXN', lines: [ { itemId: '20000000-0000-4000-8000-000000000200', quantity: 2 } ], createdAt: '2026-11-22T10:00:00Z' }]" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 201, headers: { 'content-type': 'application/json' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<http:request method="POST" config-ref="test-api-client" path="/api/v1/orders-management/orders">
				<http:body><![CDATA[#[output application/json --- { customerId: '003Hs00000CUMBRAAA', lines: [ { itemId: '20000000-0000-4000-8000-000000000200', quantity: 2 } ] }]]]></http:body>
				<http:headers><![CDATA[#[{ client_id: 'test-id', client_secret: 'test-secret', 'Content-Type': 'application/json' }]]]></http:headers>
				<http:response-validator><http:success-status-code-validator values="0..599"/></http:response-validator>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- attributes.statusCode]" is="#[MunitTools::equalTo(201)]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload.status]" is="#[MunitTools::equalTo('RECEIVED')]"/>
		</munit:validation>
	</munit:test>

	<munit:test name="api_postOrder_withoutLines_returns400" description="An order without lines breaks the contract and returns 400">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="papi-orders-main"/>
		</munit:enable-flow-sources>
		<munit:execution>
			<http:request method="POST" config-ref="test-api-client" path="/api/v1/orders-management/orders">
				<http:body><![CDATA[#[output application/json --- { customerId: '003Hs00000CUMBRAAA', lines: [] }]]]></http:body>
				<http:headers><![CDATA[#[{ client_id: 'test-id', client_secret: 'test-secret', 'Content-Type': 'application/json' }]]]></http:headers>
				<http:response-validator><http:success-status-code-validator values="0..599"/></http:response-validator>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- attributes.statusCode]" is="#[MunitTools::equalTo(400)]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload.code]" is="#[MunitTools::equalTo('VALIDATION_ERROR')]"/>
		</munit:validation>
	</munit:test>

	<munit:test name="api_getProducts_returns200" description="GET /products returns the catalog">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="papi-orders-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-inventory-page"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- [ { itemId: '20000000-0000-4000-8000-000000000100', sku: 'SKU-100', name: 'Producto 100', stock: 2, localPrice: 0, currency: 'MXN' }, { itemId: '20000000-0000-4000-8000-000000000200', sku: 'SKU-200', name: 'Producto 200', stock: 40, localPrice: 250, currency: 'MXN' }, { itemId: '20000000-0000-4000-8000-000000000300', sku: 'SKU-300', name: 'Producto 300', stock: 15, localPrice: 0, currency: 'MXN' } ]]" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 200, headers: { 'content-type': 'application/json' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-inventory-batch"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- [ { itemId: '20000000-0000-4000-8000-000000000100', sku: 'SKU-100', name: 'Producto 100', stock: 2, localPrice: 0, currency: 'MXN', providers: [ { abv: 'FAK', externalId: 7, preferred: true, lastPrice: 189 }, { abv: 'ESC', externalId: 122, preferred: false }, { abv: 'BOR', externalId: 3, preferred: false } ] }, { itemId: '20000000-0000-4000-8000-000000000200', sku: 'SKU-200', name: 'Producto 200', stock: 40, localPrice: 250, currency: 'MXN', providers: [ { abv: 'FAK', externalId: 8, preferred: true }, { abv: 'ESC', externalId: 123, preferred: false }, { abv: 'BOR', externalId: 4, preferred: false } ] }, { itemId: '20000000-0000-4000-8000-000000000300', sku: 'SKU-300', name: 'Producto 300', stock: 15, localPrice: 0, currency: 'MXN', providers: [ { abv: 'BOR', externalId: 5, preferred: true } ] } ]]" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 200, headers: { 'content-type': 'application/json' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<http:request method="GET" config-ref="test-api-client" path="/api/v1/orders-management/products">
				<http:headers><![CDATA[#[{ client_id: 'test-id', client_secret: 'test-secret' }]]]></http:headers>
				<http:response-validator><http:success-status-code-validator values="0..599"/></http:response-validator>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- attributes.statusCode]" is="#[MunitTools::equalTo(200)]"/>
			<munit-tools:assert-that expression="#[output application/java --- sizeOf(payload)]" is="#[MunitTools::equalTo(3)]"/>
		</munit:validation>
	</munit:test>

	<munit:test name="api_postProcess_returns202" description="POST /orders/process answers 202 and runs the cycle in the background">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="papi-orders-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-received-orders"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- []]" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 200, headers: { 'content-type': 'application/json' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<http:request method="POST" config-ref="test-api-client" path="/api/v1/orders-management/orders/process">
				<http:headers><![CDATA[#[{ client_id: 'test-id', client_secret: 'test-secret' }]]]></http:headers>
				<http:response-validator><http:success-status-code-validator values="0..599"/></http:response-validator>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- attributes.statusCode]" is="#[MunitTools::equalTo(202)]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload.status]" is="#[MunitTools::equalTo('STARTED')]"/>
		</munit:validation>
	</munit:test>

	<munit:test name="api_erpDown_returns503" description="With sapi-oracle-core unavailable the order listing returns a retryable 503">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="papi-orders-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-orders-list"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="HTTP:SERVICE_UNAVAILABLE"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<http:request method="GET" config-ref="test-api-client" path="/api/v1/orders-management/orders?status=RECEIVED">
				<http:headers><![CDATA[#[{ client_id: 'test-id', client_secret: 'test-secret' }]]]></http:headers>
				<http:response-validator><http:success-status-code-validator values="0..599"/></http:response-validator>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- attributes.statusCode]" is="#[MunitTools::equalTo(503)]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload.retryable]" is="#[MunitTools::equalTo(true)]"/>
		</munit:validation>
	</munit:test>

</mule>

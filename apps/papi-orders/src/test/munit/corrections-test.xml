					<munit-tools:payload value="#[output application/json --- { movementId: '40000000-0000-4000-8000-000000000001', itemId: '20000000-0000-4000-8000-000000000100', 'type': 'RESTOCK', quantity: 3, reference: '7f3c2a10-9b4e-4c1d-8e2f-5a6b7c8d9e0f', orderId: '10000000-0000-4000-8000-000000001002', resultingStock: 5, createdAt: '2026-11-22T12:45:00Z' }]" mediaType="application/json"/>

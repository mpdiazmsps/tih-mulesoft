				<munit:attributes value="#[{ uriParams: { orderId: '10000000-0000-4000-8000-000000001002' } }]"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="corrections-post-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- payload.restock.reference]" is="#[MunitTools::equalTo('7f3c2a10-9b4e-4c1d-8e2f-5a6b7c8d9e0f')]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload.outbound[0].reference]" is="#[MunitTools::equalTo('7f3c2a10-9b4e-4c1d-8e2f-5a6b7c8d9e0f-out-20000000-0000-4000-8000-000000000100')]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload.outbound[0].resultingStock]" is="#[MunitTools::equalTo(0)]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload.dispatchNote.sequence]" is="#[MunitTools::equalTo(1)]"/>
			<munit-tools:assert-that expression="#[output application/java --- vars.httpStatus]" is="#[MunitTools::equalTo(201)]"/>
			<munit-tools:verify-call processor="http:request" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-corr-restock"/>
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
			<munit-tools:verify-call processor="http:request" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-corr-outbound"/>
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
			<munit-tools:verify-call processor="http:request" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-corr-dispatch"/>
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>


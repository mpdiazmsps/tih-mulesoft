	<munit:test name="reponer_ped1002_movesStockAndEmitsDispatch" description="RESTOCK of 3 SKU-100 with C on PED-1002: restock with the key, outbound of the line and the dispatch note; 201">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-corr-order"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- { orderId: '10000000-0000-4000-8000-000000001002', customerId: '003Hs00000CUMBRAAA', status: 'CONFIRMED', currency: 'MXN', lines: [ { itemId: '20000000-0000-4000-8000-000000000100', sku: 'SKU-100', quantity: 5, unitPrice: 189, priceSource: 'LAST_PRICE', provider: 'FAK' } ], total: 945, createdAt: '2026-11-18T16:30:00Z' }]" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 200, headers: { 'content-type': 'application/json' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>

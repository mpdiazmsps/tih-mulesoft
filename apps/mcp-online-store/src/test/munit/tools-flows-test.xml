				<munit:payload value="#[output application/java --- { orderId: '10000000-0000-4000-8000-000000001002', 'type': 'RESTOCK' }]" mediaType="application/java"/>
				<munit:attributes value="#[{ additionalProperties: {} }]"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="request-correction-tool-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- vars.provider]" is="#[MunitTools::equalTo('BOR')]"/>
			<munit-tools:assert-that expression="#[output application/java --- vars.idempotencyKey]" is="#[MunitTools::equalTo('10000000-0000-4000-8000-000000001002:RESTOCK:BOR')]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload.status]" is="#[MunitTools::equalTo('PENDING')]"/>
			<munit-tools:verify-call processor="http:request" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-create-order-request"/>
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>

	<munit:test name="requestCorrection_twice_oneRequest" description="Asking twice sends the same Idempotency-Key, so papi-order-requests keeps one request">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-alternatives-for-request"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- { orderId: '10000000-0000-4000-8000-000000001002', 'type': 'RESTOCK', itemId: '20000000-0000-4000-8000-000000000100', sku: 'SKU-100', shortage: 3, currency: 'MXN', quotes: [ { provider: 'FAK', price: 189 }, { provider: 'ESC', price: 194 }, { provider: 'BOR', price: 175, cheapest: true } ], cheapest: { 'type': 'RESTOCK', itemId: '20000000-0000-4000-8000-000000000100', sku: 'SKU-100', quantity: 3, provider: 'BOR', price: 175, currency: 'MXN', cheapest: true }, providers: '3 of 3' }]" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 200, headers: { 'content-type': 'application/json' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-create-order-request"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- { requestId: '30000000-0000-4000-8000-000000000042', orderId: '10000000-0000-4000-8000-000000001002', 'type': 'RESTOCK', status: 'PENDING', requestedBy: 'agente-mcp' }]" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 202, headers: { 'content-type': 'application/json' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<munit:set-event>
				<munit:payload value="#[output application/java --- { orderId: '10000000-0000-4000-8000-000000001002', 'type': 'RESTOCK' }]" mediaType="application/java"/>
				<munit:attributes value="#[{ additionalProperties: {} }]"/>
			</munit:set-event>
			<flow-ref name="request-correction-tool-flow"/>
			<set-variable variableName="firstKey" value="#[vars.idempotencyKey]"/>
			<set-variable variableName="firstRequestId" value="#[payload.requestId]"/>
			<set-payload value="#[output application/java --- { orderId: '10000000-0000-4000-8000-000000001002', 'type': 'RESTOCK' }]"/>
			<flow-ref name="request-correction-tool-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- vars.firstKey]" is="#[MunitTools::equalTo(vars.idempotencyKey)]"/>
			<munit-tools:assert-that expression="#[output application/java --- vars.idempotencyKey]" is="#[MunitTools::equalTo('10000000-0000-4000-8000-000000001002:RESTOCK:BOR')]"/>
			<munit-tools:assert-that expression="#[output application/java --- vars.firstRequestId]" is="#[MunitTools::equalTo(payload.requestId)]"/>
			<munit-tools:verify-call processor="http:request" times="2">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-create-order-request"/>
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>


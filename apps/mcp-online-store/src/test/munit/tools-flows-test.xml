	<munit:test name="requestCorrection_restock_cheapestProviderAndKey" description="A RESTOCK without provider takes the cheapest one (BOR) and the key orderId:RESTOCK:BOR">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-alternatives-for-request"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- { orderId: '10000000-0000-4000-8000-000000001002', 'type': 'RESTOCK', itemId: '20000000-0000-4000-8000-000000000100', sku: 'SKU-100', shortage: 3, currency: 'MXN', quotes: [ { provider: 'FAK', price: 189 }, { provider: 'ESC', price: 194 }, { provider: 'BOR', price: 175, cheapest: true } ], cheapest: { 'type': 'RESTOCK', itemId: '20000000-0000-4000-8000-000000000100', sku: 'SKU-100', quantity: 3, provider: 'BOR', price: 175, currency: 'MXN', cheapest: true }, providers: '3 of 3' }]" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 200, headers: { 'content-type': 'application/json' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-create-order-request"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- { requestId: '30000000-0000-4000-8000-000000000042', orderId: '10000000-0000-4000-8000-000000001002', 'type': 'RESTOCK', status: 'PENDING', requestedBy: 'agente-mcp' }]" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 202, headers: { 'content-type': 'application/json' } }]"/>

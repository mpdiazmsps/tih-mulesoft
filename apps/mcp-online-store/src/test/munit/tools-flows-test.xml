	<!-- Per-flow tests for mcp-online-store (task 24). The Process APIs are mocked by doc:name.
	     Generated by a script; the data comes from the demo script. -->
	<munit:config name="tools-flows-test.xml"/>

	<munit:before-suite name="tools-flows-static-refs" description="Static references for MUnit (the tool flows are run through flow-ref)">
		<choice>
			<when expression="#[false]">
				<flow-ref name="get-order-tool-flow"/>
				<flow-ref name="list-exceptions-tool-flow"/>
				<flow-ref name="propose-alternatives-tool-flow"/>
				<flow-ref name="request-correction-tool-flow"/>
				<flow-ref name="get-request-tool-flow"/>
			</when>
		</choice>
	</munit:before-suite>

	<munit:test name="getOrder_returnsOrder360" description="get_order answers the Order 360 of papi-orders and identifies the agent as agente-mcp">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-order360"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- { orderId: '10000000-0000-4000-8000-000000001002', status: 'CONFIRMED', customer: { id: '003Hs00000CUMBRAAA', name: 'Constructora Cumbres', segment: 'STRATEGIC' }, sources: { erp: 'OK', crm: 'OK', logistics: 'OK', providers: '3 of 3' } }]" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 200, headers: { 'content-type': 'application/json' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:payload value="#[output application/java --- { orderId: '10000000-0000-4000-8000-000000001002' }]" mediaType="application/java"/>
				<munit:attributes value="#[{ additionalProperties: { client_id: 'agente-mcp' } }]"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="get-order-tool-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- payload.sources.providers]" is="#[MunitTools::equalTo('3 of 3')]"/>
			<munit-tools:assert-that expression="#[output application/java --- vars.papiHeaders.'x-client-app']" is="#[MunitTools::equalTo('agente-mcp')]"/>
			<munit-tools:verify-call processor="http:request" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-order360"/>
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>

	<munit:test name="listExceptions_equalsGetOrdersExceptions" description="list_exceptions answers exactly the list of GET /orders/exceptions">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-exceptions"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- [ { orderId: '10000000-0000-4000-8000-000000001002', 'type': 'STOCK_SHORTAGE', status: 'CONFIRMED', customer: { id: '003Hs00000CUMBRAAA', name: 'Constructora Cumbres', segment: 'STRATEGIC' }, detail: 'SKU-100 ordered 5, available 2' }, { orderId: '10000000-0000-4000-8000-000000001004', 'type': 'DISPATCH_REJECTED', status: 'CONFIRMED', customer: { id: '003Hs00000TAPATAAA', name: 'Grupo Hotelero Tapatío', segment: 'STRATEGIC' }, detail: 'Dirección incorrecta' } ]]" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 200, headers: { 'content-type': 'application/json' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:payload value="#[output application/java --- { limit: 20 }]" mediaType="application/java"/>
				<munit:attributes value="#[{ additionalProperties: {} }]"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="list-exceptions-tool-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- sizeOf(payload)]" is="#[MunitTools::equalTo(2)]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload[0].orderId]" is="#[MunitTools::equalTo('10000000-0000-4000-8000-000000001002')]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload[1].detail]" is="#[MunitTools::equalTo('Dirección incorrecta')]"/>
			<munit-tools:verify-call processor="http:request" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-exceptions"/>
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>


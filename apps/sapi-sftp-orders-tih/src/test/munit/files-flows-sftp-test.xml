<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:sftp="http://www.mulesoft.org/schema/mule/sftp"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
	xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/sftp http://www.mulesoft.org/schema/mule/sftp/current/mule-sftp.xsd
		http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

	<!-- Pruebas de integración con el SFTP local (Rebex, puerto 2222, ver infra/README.md): requieren que esté corriendo.
	     Usan siempre el archivo it-sftp-test.csv y lo borran de las tres carpetas antes y después de cada prueba. -->
	<munit:config name="files-flows-sftp-test.xml"/>

	<munit:before-test name="files-flows-sftp-clean-before">
		<flow-ref name="test-clean-it-file-flow"/>
	</munit:before-test>
	<munit:after-test name="files-flows-sftp-clean-after">
		<flow-ref name="test-clean-it-file-flow"/>
	</munit:after-test>

	<flow name="test-clean-it-file-flow">
		<try><sftp:delete config-ref="sftp-orders-config" path="/orders/pending/it-sftp-test.csv"/><error-handler><on-error-continue/></error-handler></try>
		<try><sftp:delete config-ref="sftp-orders-config" path="/orders/pending/it-sftp-test.csv.tmp"/><error-handler><on-error-continue/></error-handler></try>
		<try><sftp:delete config-ref="sftp-orders-config" path="/orders/processed/it-sftp-test.csv"/><error-handler><on-error-continue/></error-handler></try>
		<try><sftp:delete config-ref="sftp-orders-config" path="/orders/error/it-sftp-test.csv"/><error-handler><on-error-continue/></error-handler></try>
	</flow>

	<flow name="test-create-pending-file-flow">
		<set-payload value="#['item,qty&#10;abc,1&#10;']" mimeType="text/csv"/>
		<sftp:write config-ref="sftp-orders-config" path="/orders/pending/it-sftp-test.csv" mode="OVERWRITE"/>
	</flow>

	<!-- Propósito: PUT /files/{fileName} deposita el CSV en /orders/pending y responde 201 con su FileInfo.
	     Escenario: archivo nuevo. Resultado esperado: 201, contenido íntegro en pending y ningún .tmp huérfano. -->
	<munit:test name="filesPut_whenNewFile_thenReturn201AndFileIsInPending"
		description="Deposita el archivo y no deja .tmp">
		<munit:execution>
			<munit:set-event>
				<munit:payload value="#[output text/plain --- 'item,qty&#10;abc,1&#10;']" mediaType="text/csv"/>
				<munit:attributes value="#[{ uriParams: { fileName: 'it-sftp-test.csv' } }]"/>
			</munit:set-event>
			<flow-ref name="put:\files\(fileName):text\csv:sapi-sftp-orders-tih-config"/>
			<set-variable variableName="putResult" value="#[output application/java --- { status: vars.httpStatus, body: payload }]"/>
			<sftp:read config-ref="sftp-orders-config" path="/orders/pending/it-sftp-test.csv"/>
			<set-payload value="#[payload]" mimeType="text/plain"/>
			<set-variable variableName="storedContent" value="#[payload as String]"/>
			<sftp:list config-ref="sftp-orders-config" directoryPath="/orders/pending">
				<sftp:matcher filenamePattern="*.tmp"/>
			</sftp:list>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[vars.putResult.status]" is="#[MunitTools::equalTo(201)]"/>
			<munit-tools:assert-that expression="#[vars.putResult.body.fileName]" is="#[MunitTools::equalTo('it-sftp-test.csv')]"/>
			<munit-tools:assert-that expression="#[vars.putResult.body.status]" is="#[MunitTools::equalTo('pending')]"/>
			<munit-tools:assert-that expression="#[vars.putResult.body.size]" is="#[MunitTools::equalTo(15)]"/>
			<munit-tools:assert-that expression="#[vars.storedContent]" is="#[MunitTools::equalTo('item,qty&#10;abc,1&#10;')]"/>
			<munit-tools:assert-that expression="#[sizeOf(payload)]" is="#[MunitTools::equalTo(0)]"/>
		</munit:validation>
	</munit:test>

	<!-- Propósito: no se sobrescribe un archivo existente y no queda el .tmp.
	     Escenario: el archivo ya está en pending. Resultado esperado: FILE_ALREADY_EXISTS y ningún .tmp. -->
	<munit:test name="filesPut_whenFileAlreadyExists_thenRaiseFileAlreadyExistsAndCleanTmp"
		description="Rechaza el duplicado y limpia el temporal">
		<munit:behavior>
			<flow-ref name="test-create-pending-file-flow"/>
		</munit:behavior>
		<munit:execution>
			<try>
				<munit:set-event>
					<munit:payload value="#[output text/plain --- 'otro,contenido&#10;']" mediaType="text/csv"/>
					<munit:attributes value="#[{ uriParams: { fileName: 'it-sftp-test.csv' } }]"/>
				</munit:set-event>
				<flow-ref name="put:\files\(fileName):text\csv:sapi-sftp-orders-tih-config"/>
				<error-handler>
					<on-error-continue>
						<set-variable variableName="caughtError" value="#[error.errorType.namespace ++ ':' ++ error.errorType.identifier]"/>
					</on-error-continue>
				</error-handler>
			</try>
			<sftp:list config-ref="sftp-orders-config" directoryPath="/orders/pending">
				<sftp:matcher filenamePattern="*.tmp"/>
			</sftp:list>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[vars.caughtError]" is="#[MunitTools::equalTo('SFTP:FILE_ALREADY_EXISTS')]"/>
			<munit-tools:assert-that expression="#[sizeOf(payload)]" is="#[MunitTools::equalTo(0)]"/>
		</munit:validation>
	</munit:test>

	<!-- Propósito: GET /files/{fileName} devuelve el contenido como text/csv. Escenario: archivo en pending.
	     Resultado esperado: contenido idéntico y media type text/csv. -->
	<munit:test name="filesGet_whenFileExists_thenReturnCsvContent"
		description="Lee el archivo tal cual">
		<munit:behavior>
			<flow-ref name="test-create-pending-file-flow"/>
		</munit:behavior>
		<munit:execution>
			<munit:set-event>
				<munit:attributes value="#[{ uriParams: { fileName: 'it-sftp-test.csv' }, queryParams: {} }]"/>
			</munit:set-event>
			<flow-ref name="get:\files\(fileName):sapi-sftp-orders-tih-config"/>
			<set-payload value="#[payload]" mimeType="text/plain"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[payload as String]" is="#[MunitTools::equalTo('item,qty&#10;abc,1&#10;')]"/>
		</munit:validation>
	</munit:test>

	<!-- Propósito: un archivo inexistente se traduce en 404. Resultado esperado: SFTP:ILLEGAL_PATH (el conector usa ese tipo cuando la ruta no existe). -->
	<munit:test name="filesGet_whenFileDoesNotExist_thenRaiseFileDoesntExist"
		description="Propaga SFTP:ILLEGAL_PATH, que el manejador global responde como 404"
		expectedErrorType="SFTP:ILLEGAL_PATH">
		<munit:execution>
			<munit:set-event>
				<munit:attributes value="#[{ uriParams: { fileName: 'it-sftp-test.csv' }, queryParams: {} }]"/>
			</munit:set-event>
			<flow-ref name="get:\files\(fileName):sapi-sftp-orders-tih-config"/>
		</munit:execution>
	</munit:test>

	<!-- Propósito: GET /files lista solo los .csv de la carpeta con su FileInfo.
	     Escenario: un archivo en pending. Resultado esperado: aparece con status pending, tamaño y fecha ISO UTC. -->
	<munit:test name="filesList_whenFileIsPending_thenListItWithInfo"
		description="Lista el archivo pendiente">
		<munit:behavior>
			<flow-ref name="test-create-pending-file-flow"/>
		</munit:behavior>
		<munit:execution>
			<munit:set-event>
				<munit:attributes value="#[{ queryParams: {} }]"/>
			</munit:set-event>
			<flow-ref name="get:\files:sapi-sftp-orders-tih-config"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[payload.files filter ($.fileName == 'it-sftp-test.csv') map $.status]" is="#[MunitTools::equalTo(['pending'])]"/>
			<munit-tools:assert-that expression="#[(payload.files filter ($.fileName == 'it-sftp-test.csv'))[0].size]" is="#[MunitTools::equalTo(15)]"/>
			<munit-tools:assert-that expression="#[(payload.files filter ($.fileName == 'it-sftp-test.csv'))[0].lastModified]" is="#[MunitTools::endsWith('Z')]"/>
		</munit:validation>
	</munit:test>

	<!-- Propósito: POST /files/{fileName}/move mueve de pending a processed y devuelve el FileInfo.
	     Resultado esperado: status processed, y el archivo ya no está en pending. -->
	<munit:test name="filesMove_whenFileIsPending_thenMoveToProcessed"
		description="Mueve a processed">
		<munit:behavior>
			<flow-ref name="test-create-pending-file-flow"/>
		</munit:behavior>
		<munit:execution>
			<munit:set-event>
				<munit:payload value="#[output application/json --- { target: 'processed' }]" mediaType="application/json"/>
				<munit:attributes value="#[{ uriParams: { fileName: 'it-sftp-test.csv' } }]"/>
			</munit:set-event>
			<flow-ref name="post:\files\(fileName)\move:application\json:sapi-sftp-orders-tih-config"/>
			<set-variable variableName="moveResult" value="#[output application/java --- payload]"/>
			<sftp:list config-ref="sftp-orders-config" directoryPath="/orders/pending">
				<sftp:matcher filenamePattern="it-sftp-test.csv"/>
			</sftp:list>
			<set-variable variableName="stillPending" value="#[sizeOf(payload)]"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[vars.moveResult.fileName]" is="#[MunitTools::equalTo('it-sftp-test.csv')]"/>
			<munit-tools:assert-that expression="#[vars.moveResult.status]" is="#[MunitTools::equalTo('processed')]"/>
			<munit-tools:assert-that expression="#[vars.moveResult.size]" is="#[MunitTools::equalTo(15)]"/>
			<munit-tools:assert-that expression="#[vars.stillPending]" is="#[MunitTools::equalTo(0)]"/>
		</munit:validation>
	</munit:test>

	<!-- Propósito: mover un archivo que no está en pending se traduce en 404. Resultado esperado: SFTP:ILLEGAL_PATH (el conector usa ese tipo cuando la ruta no existe). -->
	<munit:test name="filesMove_whenFileIsMissing_thenRaiseFileDoesntExist"
		description="Propaga SFTP:ILLEGAL_PATH, que el manejador global responde como 404"
		expectedErrorType="SFTP:ILLEGAL_PATH">
		<munit:execution>
			<munit:set-event>
				<munit:payload value="#[output application/json --- { target: 'error' }]" mediaType="application/json"/>
				<munit:attributes value="#[{ uriParams: { fileName: 'it-sftp-test.csv' } }]"/>
			</munit:set-event>
			<flow-ref name="post:\files\(fileName)\move:application\json:sapi-sftp-orders-tih-config"/>
		</munit:execution>
	</munit:test>

	<!-- Propósito: mover no sobrescribe. Escenario: ya hay un archivo con ese nombre en processed.
	     Resultado esperado: SFTP:FILE_ALREADY_EXISTS (409) y el original sigue en pending. -->
	<munit:test name="filesMove_whenTargetAlreadyHasFile_thenRaiseFileAlreadyExists"
		description="Propaga SFTP:FILE_ALREADY_EXISTS (409)"
		expectedErrorType="SFTP:FILE_ALREADY_EXISTS">
		<munit:behavior>
			<flow-ref name="test-create-pending-file-flow"/>
			<set-payload value="#['previo&#10;']" mimeType="text/csv"/>
			<sftp:write config-ref="sftp-orders-config" path="/orders/processed/it-sftp-test.csv" mode="OVERWRITE"/>
		</munit:behavior>
		<munit:execution>
			<munit:set-event>
				<munit:payload value="#[output application/json --- { target: 'processed' }]" mediaType="application/json"/>
				<munit:attributes value="#[{ uriParams: { fileName: 'it-sftp-test.csv' } }]"/>
			</munit:set-event>
			<flow-ref name="post:\files\(fileName)\move:application\json:sapi-sftp-orders-tih-config"/>
		</munit:execution>
	</munit:test>

	<!-- Propósito: si el SFTP no está disponible el error se propaga para que el manejador global responda 503.
	     Escenario: sftp:list falla con SFTP:CONNECTIVITY (mock). Resultado esperado: SFTP:CONNECTIVITY. -->
	<munit:test name="filesList_whenSftpIsDown_thenPropagateConnectivityError"
		description="Propaga SFTP:CONNECTIVITY"
		expectedErrorType="SFTP:CONNECTIVITY">
		<munit:behavior>
			<munit-tools:mock-when processor="sftp:list">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="sftp-list-order-files"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="SFTP:CONNECTIVITY"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<munit:set-event>
				<munit:attributes value="#[{ queryParams: {} }]"/>
			</munit:set-event>
			<flow-ref name="get:\files:sapi-sftp-orders-tih-config"/>
		</munit:execution>
	</munit:test>

</mule>

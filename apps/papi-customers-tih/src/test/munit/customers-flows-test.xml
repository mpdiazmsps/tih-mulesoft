<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
	xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

	<!-- Pruebas unitarias de los flujos de clientes: sapi-oracle-core-tih se simula por doc:name del http:request. -->
	<munit:config name="customers-flows-test.xml"/>

	<!-- Propósito: alta exitosa. Escenario: sin duplicados y el backend crea el cliente.
	     Resultado esperado: CustomerCreated con el id y la fecha del backend, estado 201 y un único POST. -->
	<munit:test name="registerCustomer_whenNoDuplicate_thenReturnCustomerCreated">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-search-duplicates"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{ customers: [] }]" mediaType="application/java"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-create-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{ id: '3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c', name: 'Ana', email: 'ana@example.com', creationDate: '2026-10-07T16:30:00.000Z' }]" mediaType="application/java"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:payload value="#[{ name: 'Ana', email: 'ana@example.com' }]" mediaType="application/java"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="customers-register-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[payload.customerId]" is="#[MunitTools::equalTo('3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c')]"/>
			<munit-tools:assert-that expression="#[payload.creationDate]" is="#[MunitTools::equalTo('2026-10-07T16:30:00.000Z')]"/>
			<munit-tools:assert-that expression="#[vars.httpStatus]" is="#[MunitTools::equalTo(201)]"/>
			<munit-tools:verify-call processor="http:request" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-create-customer"/>
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>

	<!-- Propósito: el id y la fecha los genera esta API. Escenario: se captura el cuerpo que recibe el backend.
	     Resultado esperado: id con formato UUID, fecha presente y los datos de la solicitud; sin campos vacíos. -->
	<munit:test name="registerCustomer_whenCreating_thenSendsGeneratedIdAndDate">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-search-duplicates"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{ customers: [] }]" mediaType="application/java"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-create-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{ id: 'x', creationDate: 'y' }]" mediaType="application/java"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:payload value="#[{ name: 'Ana', phone: '+5215512345678', email: '' }]" mediaType="application/java"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="customers-register-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:verify-call processor="http:request" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-create-customer"/>
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>

	<!-- Propósito: no se permiten duplicados. Escenario: la búsqueda devuelve un cliente.
	     Resultado esperado: APP:CUSTOMER_ALREADY_EXISTS y no se intenta crear. -->
	<munit:test name="registerCustomer_whenDuplicateFound_thenAlreadyExists" expectedErrorType="APP:CUSTOMER_ALREADY_EXISTS">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-search-duplicates"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{ customers: [{ id: 'a', name: 'Ana' }] }]" mediaType="application/java"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:payload value="#[{ name: 'Ana', email: 'ana@example.com' }]" mediaType="application/java"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="customers-register-flow"/>
		</munit:execution>
	</munit:test>

	<!-- Propósito: regla email o teléfono. Escenario: solicitud sin ninguno. Resultado esperado: APP:VALIDATION_ERROR. -->
	<munit:test name="registerCustomer_whenNoEmailNorPhone_thenValidationError" expectedErrorType="APP:VALIDATION_ERROR">
		<munit:behavior>
			<munit:set-event>
				<munit:payload value="#[{ name: 'Ana', email: '' }]" mediaType="application/java"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="customers-register-flow"/>
		</munit:execution>
	</munit:test>

	<!-- Propósito: carrera entre dos altas. Escenario: la búsqueda no ve duplicado pero el backend responde 409.
	     Resultado esperado: APP:CUSTOMER_ALREADY_EXISTS (409). -->
	<munit:test name="registerCustomer_whenBackendConflict_thenConflictPropagates" expectedErrorType="APP:CUSTOMER_ALREADY_EXISTS">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-search-duplicates"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{ customers: [] }]" mediaType="application/java"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-create-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{ code: 'CUSTOMER_ALREADY_EXISTS' }]" mediaType="application/java"/>
					<munit-tools:attributes value="#[{ statusCode: 409 }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:payload value="#[{ name: 'Ana', email: 'ana@example.com' }]" mediaType="application/java"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="customers-register-flow"/>
		</munit:execution>
	</munit:test>

	<!-- Propósito: consulta exitosa. Escenario: el backend devuelve el cliente. Resultado esperado: Customer del contrato. -->
	<munit:test name="getCustomer_whenExists_thenReturnCustomer">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-get-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{ id: '3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c', name: 'Ana', email: 'ana@example.com', creationDate: '2026-10-07T16:30:00.000Z' }]" mediaType="application/java"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:attributes value="#[{ uriParams: { customerId: '3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c' } }]"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="customers-get-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[payload.id]" is="#[MunitTools::equalTo('3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c')]"/>
			<munit-tools:assert-that expression="#[payload.name]" is="#[MunitTools::equalTo('Ana')]"/>
			<munit-tools:assert-that expression="#[payload.email]" is="#[MunitTools::equalTo('ana@example.com')]"/>
			<munit-tools:assert-that expression="#[payload.lastName default 'none']" is="#[MunitTools::equalTo('none')]"/>
		</munit:validation>
	</munit:test>

	<!-- Propósito: cliente inexistente. Escenario: el backend responde 404. Resultado esperado: APP:CUSTOMER_NOT_FOUND. -->
	<munit:test name="getCustomer_whenNotFound_thenNotFoundPropagates" expectedErrorType="APP:CUSTOMER_NOT_FOUND">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-get-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{ code: 'CUSTOMER_NOT_FOUND' }]" mediaType="application/java"/>
					<munit-tools:attributes value="#[{ statusCode: 404 }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:attributes value="#[{ uriParams: { customerId: '3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c' } }]"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="customers-get-flow"/>
		</munit:execution>
	</munit:test>

</mule>

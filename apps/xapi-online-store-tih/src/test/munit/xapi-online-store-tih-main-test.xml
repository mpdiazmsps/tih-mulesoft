<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
	xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

	<!-- Pruebas HTTP: listener real en el puerto 8080 (debe estar libre) con las Process APIs simuladas.
	     Verifican que la XAPI reenvie estado, cuerpo y Retry-After, y que sus propios errores usen el ErrorResponse. -->
	<munit:config name="xapi-online-store-tih-main-test.xml"/>

	<http:request-config name="test-api-client" doc:name="HTTP Request configuration">
		<http:request-connection host="localhost" port="8080"/>
	</http:request-config>

	<!-- APIkit arma su tabla de rutas con los flujos ya inicializados (MUnit los inicia de forma perezosa). -->
	<munit:before-suite name="main-warm-up">
		<try><flow-ref name="post:\customers:application\json:xapi-online-store-tih-config"/><error-handler><on-error-continue/></error-handler></try>
		<try><flow-ref name="post:\orders:application\json:xapi-online-store-tih-config"/><error-handler><on-error-continue/></error-handler></try>
	</munit:before-suite>

	<flow name="test-post-customer-flow">
		<http:request method="POST" config-ref="test-api-client" path="/api/v1/online-store/customers">
			<http:body>#[vars.testBody]</http:body>
			<http:headers><![CDATA[#[{ client_id: 'test-id', client_secret: 'test-secret', 'Content-Type': 'application/json' }]]]></http:headers>
			<http:response-validator>
				<http:success-status-code-validator values="0..599"/>
			</http:response-validator>
		</http:request>
	</flow>

	<flow name="test-post-order-flow">
		<http:request method="POST" config-ref="test-api-client" path="/api/v1/online-store/orders">
			<http:body>#[vars.testBody]</http:body>
			<http:headers><![CDATA[#[{ client_id: 'test-id', client_secret: 'test-secret', 'Content-Type': 'application/json' }]]]></http:headers>
			<http:response-validator>
				<http:success-status-code-validator values="0..599"/>
			</http:response-validator>
		</http:request>
	</flow>

	<!-- Proposito: el 201 de papi-customers se reenvia con su cuerpo. Resultado esperado: 201 y customerId. -->
	<munit:test name="apiPostCustomer_whenCreated_thenForward201">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="xapi-online-store-tih-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-register-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#['{&quot;customerId&quot;:&quot;3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c&quot;,&quot;creationDate&quot;:&quot;2026-10-07T16:30:00.000Z&quot;}']" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 201, headers: {} }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<set-variable variableName="testBody" value="#['{&quot;name&quot;:&quot;Ana&quot;,&quot;email&quot;:&quot;ana@example.com&quot;}']"/>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="test-post-customer-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[attributes.statusCode]" is="#[MunitTools::equalTo(201)]"/>
			<munit-tools:assert-that expression="#[payload.customerId]" is="#[MunitTools::equalTo('3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c')]"/>
		</munit:validation>
	</munit:test>

	<!-- Proposito: los errores de negocio de la PAPI se reenvian intactos. Escenario: 409 CUSTOMER_ALREADY_EXISTS. Resultado esperado: 409 con el mismo codigo. -->
	<munit:test name="apiPostCustomer_whenDuplicate_thenForward409">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="xapi-online-store-tih-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-register-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#['{&quot;code&quot;:&quot;CUSTOMER_ALREADY_EXISTS&quot;,&quot;message&quot;:&quot;Ya existe&quot;}']" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 409, headers: {} }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<set-variable variableName="testBody" value="#['{&quot;name&quot;:&quot;Ana&quot;,&quot;email&quot;:&quot;ana@example.com&quot;}']"/>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="test-post-customer-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[attributes.statusCode]" is="#[MunitTools::equalTo(409)]"/>
			<munit-tools:assert-that expression="#[payload.code]" is="#[MunitTools::equalTo('CUSTOMER_ALREADY_EXISTS')]"/>
		</munit:validation>
	</munit:test>

	<!-- Proposito: Retry-After de la PAPI llega al consumidor. Resultado esperado: 503 y Retry-After 30. -->
	<munit:test name="apiPostCustomer_whenPapiUnavailable_thenForward503WithRetryAfter">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="xapi-online-store-tih-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-register-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#['{&quot;code&quot;:&quot;SERVICE_UNAVAILABLE&quot;}']" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 503, headers: { 'retry-after': '30' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<set-variable variableName="testBody" value="#['{&quot;name&quot;:&quot;Ana&quot;,&quot;email&quot;:&quot;ana@example.com&quot;}']"/>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="test-post-customer-flow"/>
			<set-variable variableName="retryAfter" value="#[attributes.headers.'retry-after']"/>
			<set-variable variableName="statusCode" value="#[attributes.statusCode]"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[vars.statusCode]" is="#[MunitTools::equalTo(503)]"/>
			<munit-tools:assert-that expression="#[payload.code]" is="#[MunitTools::equalTo('SERVICE_UNAVAILABLE')]"/>
			<munit-tools:assert-that expression="#[vars.retryAfter]" is="#[MunitTools::equalTo('30')]"/>
		</munit:validation>
	</munit:test>

	<!-- Proposito: si la PAPI no responde, la XAPI contesta su propio ErrorResponse. Resultado esperado: 503 retryable con Retry-After 30. -->
	<munit:test name="apiPostCustomer_whenPapiDown_thenOwn503">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="xapi-online-store-tih-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-register-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="HTTP:CONNECTIVITY"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<set-variable variableName="testBody" value="#['{&quot;name&quot;:&quot;Ana&quot;,&quot;email&quot;:&quot;ana@example.com&quot;}']"/>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="test-post-customer-flow"/>
			<set-variable variableName="retryAfter" value="#[attributes.headers.'retry-after']"/>
			<set-variable variableName="statusCode" value="#[attributes.statusCode]"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[vars.statusCode]" is="#[MunitTools::equalTo(503)]"/>
			<munit-tools:assert-that expression="#[payload.code]" is="#[MunitTools::equalTo('SERVICE_UNAVAILABLE')]"/>
			<munit-tools:assert-that expression="#[payload.retryable]" is="#[MunitTools::equalTo(true)]"/>
			<munit-tools:assert-that expression="#[vars.retryAfter]" is="#[MunitTools::equalTo('30')]"/>
		</munit:validation>
	</munit:test>

	<!-- Proposito: APIkit valida el contrato antes de llamar a la PAPI. Escenario: email invalido. Resultado esperado: 400 VALIDATION_ERROR. -->
	<munit:test name="apiPostCustomer_whenContractViolated_thenReturn400">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="xapi-online-store-tih-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<set-variable variableName="testBody" value="#['{&quot;name&quot;:&quot;Ana&quot;,&quot;email&quot;:&quot;x&quot;}']"/>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="test-post-customer-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[attributes.statusCode]" is="#[MunitTools::equalTo(400)]"/>
			<munit-tools:assert-that expression="#[payload.code]" is="#[MunitTools::equalTo('VALIDATION_ERROR')]"/>
		</munit:validation>
	</munit:test>

	<!-- Proposito: el 201 de papi-orders se reenvia. Resultado esperado: 201 RECEIVED. -->
	<munit:test name="apiPostOrder_whenReceived_thenForward201">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="xapi-online-store-tih-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-create-order"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#['{&quot;orderId&quot;:&quot;9d8c7b6a-5f4e-4d3c-8b2a-1f0e9d8c7b6a&quot;,&quot;status&quot;:&quot;RECEIVED&quot;}']" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 201, headers: {} }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<set-variable variableName="testBody" value="#['{&quot;customerId&quot;:&quot;3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c&quot;,&quot;items&quot;:[{&quot;itemId&quot;:&quot;c1a2b3c4-d5e6-4789-a012-3456789abc01&quot;,&quot;quantity&quot;:2}]}']"/>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="test-post-order-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[attributes.statusCode]" is="#[MunitTools::equalTo(201)]"/>
			<munit-tools:assert-that expression="#[payload.status]" is="#[MunitTools::equalTo('RECEIVED')]"/>
		</munit:validation>
	</munit:test>

	<!-- Proposito: cliente inexistente. Escenario: papi-orders responde 404. Resultado esperado: 404 CUSTOMER_NOT_FOUND. -->
	<munit:test name="apiPostOrder_whenCustomerNotFound_thenForward404">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="xapi-online-store-tih-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-create-order"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#['{&quot;code&quot;:&quot;CUSTOMER_NOT_FOUND&quot;}']" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 404, headers: {} }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<set-variable variableName="testBody" value="#['{&quot;customerId&quot;:&quot;3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c&quot;,&quot;items&quot;:[{&quot;itemId&quot;:&quot;c1a2b3c4-d5e6-4789-a012-3456789abc01&quot;,&quot;quantity&quot;:2}]}']"/>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="test-post-order-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[attributes.statusCode]" is="#[MunitTools::equalTo(404)]"/>
			<munit-tools:assert-that expression="#[payload.code]" is="#[MunitTools::equalTo('CUSTOMER_NOT_FOUND')]"/>
		</munit:validation>
	</munit:test>

	<!-- Proposito: PAPI de pedidos caida. Resultado esperado: 503 SERVICE_UNAVAILABLE. -->
	<munit:test name="apiPostOrder_whenPapiDown_thenOwn503">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="xapi-online-store-tih-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-create-order"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="HTTP:CONNECTIVITY"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<set-variable variableName="testBody" value="#['{&quot;customerId&quot;:&quot;3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c&quot;,&quot;items&quot;:[{&quot;itemId&quot;:&quot;c1a2b3c4-d5e6-4789-a012-3456789abc01&quot;,&quot;quantity&quot;:2}]}']"/>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="test-post-order-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[attributes.statusCode]" is="#[MunitTools::equalTo(503)]"/>
			<munit-tools:assert-that expression="#[payload.code]" is="#[MunitTools::equalTo('SERVICE_UNAVAILABLE')]"/>
		</munit:validation>
	</munit:test>

	<!-- Proposito: APIkit rechaza un pedido sin articulos. Resultado esperado: 400 VALIDATION_ERROR. -->
	<munit:test name="apiPostOrder_whenContractViolated_thenReturn400">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="xapi-online-store-tih-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<set-variable variableName="testBody" value="#['{&quot;customerId&quot;:&quot;3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c&quot;,&quot;items&quot;:[]}']"/>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="test-post-order-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[attributes.statusCode]" is="#[MunitTools::equalTo(400)]"/>
			<munit-tools:assert-that expression="#[payload.code]" is="#[MunitTools::equalTo('VALIDATION_ERROR')]"/>
		</munit:validation>
	</munit:test>

</mule>

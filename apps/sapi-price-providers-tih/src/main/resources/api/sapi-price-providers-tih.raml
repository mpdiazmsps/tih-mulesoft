#%RAML 1.0
title: sapi-price-providers-tih
version: v1
baseUri: http://localhost:8093/api/v1/price-providers
protocols: [HTTP]
mediaType: application/json
description: |
  System API de proveedores de precios. Ofrece una sola fachada con modelo canónico y oculta las diferencias
  entre proveedores.
  - FAK: Fakestore (REST). GET https://fakestoreapi.com/products/{id}
  - ESC: Escuelajs (REST). GET https://api.escuelajs.co/api/v1/products/{id}
  - BOR: Borland (SOAP 1.1, servicio OrderService, operación GetArticleById). En local lo atiende un mock de SoapUI (http://localhost:8088/mockOrderServiceSoap).

uses:
  types: fragments/tih-common-types.raml
  traits: fragments/tih-common-traits.raml

/providers/{providerAbv}/products/{externalId}/price:
  uriParameters:
    providerAbv:
      description: Clave del proveedor (INVENTORY.PROVIDER_ABV).
      type: types.ProviderAbv
    externalId:
      description: Identificador del artículo en el proveedor (INVENTORY.EXTERNAL_ID).
      type: integer
      minimum: 1
      example: 1
  get:
    displayName: Consultar precio
    description: |
      Consulta el precio de un artículo con el proveedor indicado.
      404 si el proveedor no conoce el artículo,
      502 si el proveedor responde con error y 503 si no está disponible.
    is: [traits.secured, traits.validated, traits.not-found, traits.bad-gateway, traits.retryable]
    responses:
      200:
        description: Precio encontrado.
        body:
          application/json:
            type: types.Price

<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:os="http://www.mulesoft.org/schema/mule/os"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
	xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
		http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd
		http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

	<!-- Pruebas unitarias de orders-receive-flow: customers y SFTP se simulan por doc:name del http:request. -->
	<munit:config name="receive-order-test.xml"/>

	<!-- Ningún test debe publicar en el RabbitMQ real: amqp:publish se simula antes de cada prueba. -->
	<munit:before-test name="mock-amqp-publish-before-test">
		<munit-tools:mock-when processor="amqp:publish">
			<munit-tools:then-return>
				<munit-tools:payload value="#['published']" mediaType="application/java"/>
			</munit-tools:then-return>
		</munit-tools:mock-when>
	</munit:before-test>

	<!-- Proposito: recibir un pedido valido. Escenario: el cliente existe y el SFTP acepta el archivo. Resultado esperado: OrderReceived RECEIVED, archivo customerId_orderId.csv, estado 201 y un unico PUT. -->
	<munit:test name="receiveOrder_whenCustomerExists_thenDepositCsvAndReturnReceived">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-get-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{ id: '3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c', name: 'Ana' }]" mediaType="application/java"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-put-order-file"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{ fileName: 'x', status: 'pending' }]" mediaType="application/java"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:payload value="#[{ customerId: '3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c', items: [{ itemId: 'c1a2b3c4-d5e6-4789-a012-3456789abc01', quantity: 2 }, { itemId: '7a8b9c0d-1e2f-43a4-b5c6-d7e8f9a0b1c2', quantity: 1 }] }]" mediaType="application/java"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="orders-receive-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[payload.status]" is="#[MunitTools::equalTo('RECEIVED')]"/>
			<munit-tools:assert-that expression="#[payload.customerId]" is="#[MunitTools::equalTo('3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c')]"/>
			<munit-tools:assert-that expression="#[vars.httpStatus]" is="#[MunitTools::equalTo(201)]"/>
			<munit-tools:assert-that expression="#[payload.fileName]" is="#[MunitTools::equalTo(payload.customerId ++ '_' ++ payload.orderId ++ '.csv')]"/>
			<munit-tools:assert-that expression="#[payload.orderId matches /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/]" is="#[MunitTools::equalTo(true)]"/>
			<munit-tools:verify-call processor="http:request" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-put-order-file"/>
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>

	<!-- Proposito: no se aceptan pedidos de clientes inexistentes. Escenario: papi-customers responde 404. Resultado esperado: APP:CUSTOMER_NOT_FOUND y no se deposita archivo. -->
	<munit:test name="receiveOrder_whenCustomerNotFound_thenCustomerNotFound" expectedErrorType="APP:CUSTOMER_NOT_FOUND">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-get-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{ code: 'CUSTOMER_NOT_FOUND' }]" mediaType="application/java"/>
					<munit-tools:attributes value="#[{ statusCode: 404 }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:payload value="#[{ customerId: '3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c', items: [{ itemId: 'c1a2b3c4-d5e6-4789-a012-3456789abc01', quantity: 2 }, { itemId: '7a8b9c0d-1e2f-43a4-b5c6-d7e8f9a0b1c2', quantity: 1 }] }]" mediaType="application/java"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="orders-receive-flow"/>
		</munit:execution>
	</munit:test>

	<!-- Proposito: Oracle no admite el mismo articulo dos veces en un pedido. Escenario: itemId repetido. Resultado esperado: APP:VALIDATION_ERROR sin consultar al cliente. -->
	<munit:test name="receiveOrder_whenDuplicateItems_thenValidationError" expectedErrorType="APP:VALIDATION_ERROR">
		<munit:behavior>
			<munit:set-event>
				<munit:payload value="#[{ customerId: '3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c', items: [{ itemId: 'c1a2b3c4-d5e6-4789-a012-3456789abc01', quantity: 2 }, { itemId: 'c1a2b3c4-d5e6-4789-a012-3456789abc01', quantity: 1 }] }]" mediaType="application/java"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="orders-receive-flow"/>
		</munit:execution>
	</munit:test>

	<!-- Proposito: la caida del SFTP no se oculta. Escenario: el PUT falla por conectividad. Resultado esperado: HTTP:CONNECTIVITY (el catalogo lo responde como 503). -->
	<munit:test name="receiveOrder_whenSftpUnavailable_thenConnectivityPropagates" expectedErrorType="HTTP:CONNECTIVITY">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-get-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{ id: '3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c' }]" mediaType="application/java"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-put-order-file"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="HTTP:CONNECTIVITY"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:payload value="#[{ customerId: '3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c', items: [{ itemId: 'c1a2b3c4-d5e6-4789-a012-3456789abc01', quantity: 2 }, { itemId: '7a8b9c0d-1e2f-43a4-b5c6-d7e8f9a0b1c2', quantity: 1 }] }]" mediaType="application/java"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="orders-receive-flow"/>
		</munit:execution>
	</munit:test>

</mule>

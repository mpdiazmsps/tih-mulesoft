		<munit:execution>
			<flow-ref name="orders-acquire-lock-subflow"/>
		</munit:execution>
	</munit:test>

	<!-- Proposito: el disparo manual responde de inmediato. Escenario: no hay ciclo en curso. Resultado esperado: ProcessResult ACCEPTED y estado 202. -->

	<!-- Proposito: el ciclo recorre todos los archivos y libera el candado. Escenario: dos archivos pendientes. Resultado esperado: orders-process-file-flow invocado 2 veces y candado liberado (se puede tomar de nuevo). -->
	<munit:test name="processPending_whenTwoFiles_thenProcessesEachAndReleasesLock">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-list-pending-files"/>

					<munit-tools:payload value="#[{}]" mediaType="application/java"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<flow-ref name="orders-acquire-lock-subflow"/>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="orders-process-pending-flow"/>
		</munit:execution>
		<munit:validation>

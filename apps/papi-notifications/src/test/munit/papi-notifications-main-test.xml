<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
	xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

	<!-- HTTP tests for papi-notifications: the listener on 8084 must be free. papi-customers and MagicBell are mocked. -->
	<munit:config name="papi-notifications-main-test.xml"/>

	<munit:before-suite name="papi-notifications-main-warm-up" description="APIkit builds its routes from the flows already initialized">
		<choice>
			<when expression="#[false]">
				<flow-ref name="post:\orders-registered:application\json:papi-notifications-config"/>
			</when>
		</choice>
	</munit:before-suite>

	<http:request-config name="test-api-client" doc:name="HTTP Request configuration">
		<http:request-connection host="localhost" port="8084"/>
	</http:request-config>

	<munit:test name="api_resendOrderRegistered_returns200Sent" description="POST /orders-registered emails the customer and returns SENT">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="papi-notifications-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-get-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- { id: '003Hs00000CUMBRAAA', name: 'Constructora Cumbres', email: 'compras@cumbres.ejemplo.mx', segment: 'STRATEGIC' }]" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 200, headers: { 'content-type': 'application/json' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-magicbell-broadcast"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- { id: 'b-6f1d2c3b', status: 'enqueued' }]" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 201, headers: { 'content-type': 'application/json' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<http:request method="POST" config-ref="test-api-client" path="/api/v1/notifications/orders-registered">
				<http:body><![CDATA[#[output application/json --- { eventType: 'order.registered', orderId: '10000000-0000-4000-8000-000000001003', customerId: '003Hs00000CUMBRAAA', currency: 'MXN', lines: [ { itemId: '20000000-0000-4000-8000-000000000200', sku: 'SKU-200', quantity: 3, unitPrice: 250, priceSource: 'LOCAL' } ], total: 750, occurredAt: '2026-11-19T17:00:00Z' }]]]></http:body>
				<http:headers><![CDATA[#[{ client_id: 'test-id', client_secret: 'test-secret', 'Content-Type': 'application/json' }]]]></http:headers>
				<http:response-validator><http:success-status-code-validator values="0..599"/></http:response-validator>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- attributes.statusCode]" is="#[MunitTools::equalTo(200)]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload.status]" is="#[MunitTools::equalTo('SENT')]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload.recipient]" is="#[MunitTools::equalTo('demo@ejemplo.mx')]"/>
		</munit:validation>
	</munit:test>

	<munit:test name="api_missingClientHeaders_returns400" description="client_id and client_secret are required by the contract">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="papi-notifications-main"/>
		</munit:enable-flow-sources>
		<munit:execution>
			<http:request method="POST" config-ref="test-api-client" path="/api/v1/notifications/orders-registered">
				<http:body><![CDATA[#[output application/json --- { eventType: 'order.registered', orderId: '10000000-0000-4000-8000-000000001003', customerId: '003Hs00000CUMBRAAA', currency: 'MXN', lines: [ { itemId: '20000000-0000-4000-8000-000000000200', sku: 'SKU-200', quantity: 3, unitPrice: 250, priceSource: 'LOCAL' } ], total: 750, occurredAt: '2026-11-19T17:00:00Z' }]]]></http:body>
				<http:headers><![CDATA[#[{ 'Content-Type': 'application/json' }]]]></http:headers>
				<http:response-validator><http:success-status-code-validator values="0..599"/></http:response-validator>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- attributes.statusCode]" is="#[MunitTools::equalTo(400)]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload.code]" is="#[MunitTools::equalTo('VALIDATION_ERROR')]"/>
		</munit:validation>
	</munit:test>

	<munit:test name="api_unknownCustomer_returns404" description="An unknown customer returns 404 CUSTOMER_NOT_FOUND">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="papi-notifications-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-get-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- { code: 'CUSTOMER_NOT_FOUND' }]" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 404, headers: { 'content-type': 'application/json' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<http:request method="POST" config-ref="test-api-client" path="/api/v1/notifications/orders-registered">
				<http:body><![CDATA[#[output application/json --- { eventType: 'order.registered', orderId: '10000000-0000-4000-8000-000000001003', customerId: '003Hs00000CUMBRAAA', currency: 'MXN', lines: [ { itemId: '20000000-0000-4000-8000-000000000200', sku: 'SKU-200', quantity: 3, unitPrice: 250, priceSource: 'LOCAL' } ], total: 750, occurredAt: '2026-11-19T17:00:00Z' }]]]></http:body>
				<http:headers><![CDATA[#[{ client_id: 'test-id', client_secret: 'test-secret', 'Content-Type': 'application/json' }]]]></http:headers>
				<http:response-validator><http:success-status-code-validator values="0..599"/></http:response-validator>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- attributes.statusCode]" is="#[MunitTools::equalTo(404)]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload.code]" is="#[MunitTools::equalTo('CUSTOMER_NOT_FOUND')]"/>
		</munit:validation>
	</munit:test>

	<munit:test name="api_magicbellUnauthorized_returns502" description="A token MagicBell does not accept returns 502 PROVIDER_REJECTED, not retryable">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="papi-notifications-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-get-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- { id: '003Hs00000CUMBRAAA', name: 'Constructora Cumbres', email: 'compras@cumbres.ejemplo.mx', segment: 'STRATEGIC' }]" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 200, headers: { 'content-type': 'application/json' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-magicbell-broadcast"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="HTTP:UNAUTHORIZED"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<http:request method="POST" config-ref="test-api-client" path="/api/v1/notifications/orders-registered">
				<http:body><![CDATA[#[output application/json --- { eventType: 'order.registered', orderId: '10000000-0000-4000-8000-000000001003', customerId: '003Hs00000CUMBRAAA', currency: 'MXN', lines: [ { itemId: '20000000-0000-4000-8000-000000000200', sku: 'SKU-200', quantity: 3, unitPrice: 250, priceSource: 'LOCAL' } ], total: 750, occurredAt: '2026-11-19T17:00:00Z' }]]]></http:body>
				<http:headers><![CDATA[#[{ client_id: 'test-id', client_secret: 'test-secret', 'Content-Type': 'application/json' }]]]></http:headers>
				<http:response-validator><http:success-status-code-validator values="0..599"/></http:response-validator>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- attributes.statusCode]" is="#[MunitTools::equalTo(502)]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload.code]" is="#[MunitTools::equalTo('PROVIDER_REJECTED')]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload.retryable]" is="#[MunitTools::equalTo(false)]"/>
		</munit:validation>
	</munit:test>

	<munit:test name="api_customersDown_returns503" description="With papi-customers down the API returns a retryable 503 with Retry-After">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="papi-notifications-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-get-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="HTTP:CONNECTIVITY"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<http:request method="POST" config-ref="test-api-client" path="/api/v1/notifications/orders-registered">
				<http:body><![CDATA[#[output application/json --- { eventType: 'order.registered', orderId: '10000000-0000-4000-8000-000000001003', customerId: '003Hs00000CUMBRAAA', currency: 'MXN', lines: [ { itemId: '20000000-0000-4000-8000-000000000200', sku: 'SKU-200', quantity: 3, unitPrice: 250, priceSource: 'LOCAL' } ], total: 750, occurredAt: '2026-11-19T17:00:00Z' }]]]></http:body>
				<http:headers><![CDATA[#[{ client_id: 'test-id', client_secret: 'test-secret', 'Content-Type': 'application/json' }]]]></http:headers>
				<http:response-validator><http:success-status-code-validator values="0..599"/></http:response-validator>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- attributes.statusCode]" is="#[MunitTools::equalTo(503)]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload.retryable]" is="#[MunitTools::equalTo(true)]"/>
			<munit-tools:assert-that expression="#[output application/java --- attributes.headers['retry-after']]" is="#[MunitTools::equalTo('30')]"/>
		</munit:validation>
	</munit:test>

</mule>

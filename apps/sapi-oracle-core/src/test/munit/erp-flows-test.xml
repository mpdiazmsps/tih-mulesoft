	<!-- Per-flow tests for sapi-oracle-core (task 11). Oracle is mocked by the doc:name of each operation;
	     Oracle errors are mocked with the ORA-xxxxx description that the app translates into business errors.
	     Generated by a script; the data comes from the demo script (data/scenario.json). -->
	<munit:config name="erp-flows-test.xml"/>

	<munit:test name="postOrder_createsReceivedWithAllLines" description="A 2-line order is inserted in one transaction, returns 201 and starts RECEIVED with its 2 lines">
		<munit:behavior>
			<munit-tools:mock-when processor="db:insert">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="db-insert-order"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/java --- { affectedRows: 1 }]" mediaType="application/java"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="db:insert">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="db-insert-order-item"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/java --- { affectedRows: 1 }]" mediaType="application/java"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="db:select">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="db-select-order"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/java --- readUrl('classpath://payloads/order-new-rows.json', 'application/json')]" mediaType="application/java"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<munit:set-event>
				<munit:payload value="#[output application/json --- readUrl('classpath://payloads/order-create-request.json', 'application/json')]" mediaType="application/json"/>
			</munit:set-event>
			<flow-ref name="post:\orders:application\json:sapi-oracle-core-config"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- vars.httpStatus]" is="#[MunitTools::equalTo(201)]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload.status]" is="#[MunitTools::equalTo('RECEIVED')]"/>
			<munit-tools:assert-that expression="#[output application/java --- sizeOf(payload.lines)]" is="#[MunitTools::equalTo(2)]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload.lines[1].sku]" is="#[MunitTools::equalTo('SKU-200')]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload.createdAt]" is="#[MunitTools::equalTo('2026-11-21T15:00:00Z')]"/>
			<munit-tools:verify-call processor="db:insert" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="db-insert-order"/>
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
			<munit-tools:verify-call processor="db:insert" times="2">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="db-insert-order-item"/>
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>

	<munit:test name="postOrder_duplicateId_returns409" description="An existing orderId (ORA-00001 on PK_ORDERS) returns ORDER_ALREADY_EXISTS" expectedErrorType="APP:ORDER_ALREADY_EXISTS">

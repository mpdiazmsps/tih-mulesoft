<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
	xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

	<!-- Per-flow tests for xapi-online-store (task 23). The Process APIs are mocked by doc:name.
	     Generated by a script; the data comes from the demo script. -->
	<munit:config name="operations-flows-test.xml"/>

	<munit:test name="order360_passThroughFromPapiOrders" description="The Order 360 of papi-orders reaches the store as it is, with its sources">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-papi-orders"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- { orderId: '10000000-0000-4000-8000-000000001002', status: 'CONFIRMED', customer: { id: '003Hs00000CUMBRAAA', name: 'Constructora Cumbres', segment: 'STRATEGIC' }, lines: [ { itemId: '20000000-0000-4000-8000-000000000100', sku: 'SKU-100', quantity: 5, available: 2 } ], sources: { erp: 'OK', crm: 'OK', logistics: 'OK', providers: '3 of 3' } }]" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 200, headers: { 'content-type': 'application/json' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:attributes value="#[{ headers: { client_id: 'tienda-web' }, uriParams: { orderId: '10000000-0000-4000-8000-000000001002' }, queryParams: {} }]"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="order360-get-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- vars.httpStatus]" is="#[MunitTools::equalTo(200)]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload.sources.providers]" is="#[MunitTools::equalTo('3 of 3')]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload.customer.name]" is="#[MunitTools::equalTo('Constructora Cumbres')]"/>
			<munit-tools:assert-that expression="#[output application/java --- vars.call.path]" is="#[MunitTools::equalTo('/orders/10000000-0000-4000-8000-000000001002')]"/>
			<munit-tools:verify-call processor="http:request" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-papi-orders"/>
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>

	<munit:test name="approve_propagatesClientApp" description="Approving passes the caller client_id to papi-order-requests as x-client-app (D10)">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-papi-order-requests"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- { requestId: '30000000-0000-4000-8000-000000000042', orderId: '10000000-0000-4000-8000-000000001002', 'type': 'RESTOCK', status: 'COMPLETED', idempotencyKey: '7f3c2a10-9b4e-4c1d-8e2f-5a6b7c8d9e0f', requestedBy: 'agente-mcp' }]" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 200, headers: { 'content-type': 'application/json' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:attributes value="#[{ headers: { client_id: 'aprobador-tienda' }, uriParams: { requestId: '30000000-0000-4000-8000-000000000042' }, queryParams: {} }]"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="request-approve-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- vars.papiHeaders.'x-client-app']" is="#[MunitTools::equalTo('aprobador-tienda')]"/>
			<munit-tools:assert-that expression="#[output application/java --- vars.call.method]" is="#[MunitTools::equalTo('POST')]"/>
			<munit-tools:assert-that expression="#[output application/java --- vars.call.path]" is="#[MunitTools::equalTo('/order-requests/30000000-0000-4000-8000-000000000042/approve')]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload.status]" is="#[MunitTools::equalTo('COMPLETED')]"/>
		</munit:validation>
	</munit:test>

	<munit:test name="approve_byAgent_forwards403" description="The agent application cannot approve: the 403 of papi-order-requests is forwarded as it is">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-papi-order-requests"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- { code: 'FORBIDDEN', message: 'Only an approver can decide on a request', retryable: false }]" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 403, headers: { 'content-type': 'application/json' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:attributes value="#[{ headers: { client_id: 'agente-mcp' }, uriParams: { requestId: '30000000-0000-4000-8000-000000000042' }, queryParams: {} }]"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="request-approve-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- vars.httpStatus]" is="#[MunitTools::equalTo(403)]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload.code]" is="#[MunitTools::equalTo('FORBIDDEN')]"/>
			<munit-tools:assert-that expression="#[output application/java --- vars.papiHeaders.'x-client-app']" is="#[MunitTools::equalTo('agente-mcp')]"/>
		</munit:validation>
	</munit:test>

	<munit:test name="requestCreate_locationPointsToXapi" description="A new request answers 202 with a Location of this API and passes the Idempotency-Key">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-papi-order-requests"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- { requestId: '30000000-0000-4000-8000-000000000042', orderId: '10000000-0000-4000-8000-000000001002', 'type': 'RESTOCK', status: 'PENDING', idempotencyKey: '7f3c2a10-9b4e-4c1d-8e2f-5a6b7c8d9e0f', requestedBy: 'agente-mcp' }]" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 202, headers: { 'content-type': 'application/json', location: '/api/v1/order-requests/30000000-0000-4000-8000-000000000042' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:payload value="#[output application/json --- { orderId: '10000000-0000-4000-8000-000000001002', 'type': 'REISSUE' }]" mediaType="application/json"/>
				<munit:attributes value="#[{ headers: { client_id: 'tienda-web', 'idempotency-key': '7f3c2a10-9b4e-4c1d-8e2f-5a6b7c8d9e0f' }, uriParams: {}, queryParams: {} }]"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="requests-create-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- vars.httpStatus]" is="#[MunitTools::equalTo(202)]"/>
			<munit-tools:assert-that expression="#[output application/java --- vars.outboundHeaders.Location]" is="#[MunitTools::equalTo('/api/v1/online-store/order-requests/30000000-0000-4000-8000-000000000042')]"/>
			<munit-tools:assert-that expression="#[output application/java --- vars.papiHeaders.'Idempotency-Key']" is="#[MunitTools::equalTo('7f3c2a10-9b4e-4c1d-8e2f-5a6b7c8d9e0f')]"/>
		</munit:validation>
	</munit:test>

	<munit:test name="papi503_retryAfterForwarded" description="A Process API 503 is forwarded with its Retry-After">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-papi-orders"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- { code: 'SERVICE_UNAVAILABLE', message: 'Service temporarily unavailable, please retry', retryable: true }]" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 503, headers: { 'content-type': 'application/json', 'retry-after': '30' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:attributes value="#[{ headers: { client_id: 'tienda-web' }, uriParams: {}, queryParams: { limit: '20' } }]"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="orders-exceptions-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- vars.httpStatus]" is="#[MunitTools::equalTo(503)]"/>
			<munit-tools:assert-that expression="#[output application/java --- vars.outboundHeaders.'Retry-After']" is="#[MunitTools::equalTo('30')]"/>
			<munit-tools:assert-that expression="#[output application/java --- vars.call.query.limit]" is="#[MunitTools::equalTo('20')]"/>
		</munit:validation>
	</munit:test>

	<munit:test name="papiDown_raisesConnectivity" description="An unreachable Process API raises HTTP:CONNECTIVITY (the global handler answers 503)" expectedErrorType="HTTP:CONNECTIVITY">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-papi-customers"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="HTTP:CONNECTIVITY"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:attributes value="#[{ headers: { client_id: 'tienda-web' }, uriParams: {}, queryParams: {} }]"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="customers-list-flow"/>
		</munit:execution>
	</munit:test>

	<munit:test name="withoutClientId_unknownClient" description="Without client_id the Process API sees unknown-client (in the cloud the policy answers 401 first)">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-papi-orders"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- []]" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 200, headers: { 'content-type': 'application/json' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:attributes value="#[{ headers: {}, uriParams: {}, queryParams: {} }]"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="catalog-get-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- vars.papiHeaders.'x-client-app']" is="#[MunitTools::equalTo('unknown-client')]"/>
			<munit-tools:assert-that expression="#[output application/java --- vars.httpStatus]" is="#[MunitTools::equalTo(200)]"/>
		</munit:validation>
	</munit:test>

</mule>

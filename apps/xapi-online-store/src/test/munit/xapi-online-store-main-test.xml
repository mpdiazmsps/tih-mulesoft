	<!-- HTTP tests for xapi-online-store: one routing test per operation (the mocked Process API echoes the call it
	     received) plus contract checks. The listener on 8080 must be free. -->
	<munit:config name="xapi-online-store-main-test.xml"/>

	<munit:before-suite name="xapi-online-store-main-warm-up" description="APIkit builds its routes from the flows already initialized">
		<choice>
			<when expression="#[false]">
				<flow-ref name="get:\products:xapi-online-store-config"/>
				<flow-ref name="get:\customers:xapi-online-store-config"/>
				<flow-ref name="post:\customers:application\json:xapi-online-store-config"/>
				<flow-ref name="get:\customers\(customerId):xapi-online-store-config"/>
				<flow-ref name="get:\orders:xapi-online-store-config"/>
				<flow-ref name="post:\orders:application\json:xapi-online-store-config"/>
				<flow-ref name="get:\orders\exceptions:xapi-online-store-config"/>
				<flow-ref name="get:\orders\(orderId):xapi-online-store-config"/>
				<flow-ref name="get:\orders\(orderId)\alternatives:xapi-online-store-config"/>
				<flow-ref name="post:\order-requests:application\json:xapi-online-store-config"/>
				<flow-ref name="get:\order-requests:xapi-online-store-config"/>
				<flow-ref name="get:\order-requests\(requestId):xapi-online-store-config"/>
				<flow-ref name="post:\order-requests\(requestId)\approve:xapi-online-store-config"/>
				<flow-ref name="post:\order-requests\(requestId)\reject:application\json:xapi-online-store-config"/>
			</when>
		</choice>
	</munit:before-suite>

	<http:request-config name="test-api-client" doc:name="HTTP Request configuration">
		<http:request-connection host="localhost" port="8080"/>
	</http:request-config>

	<munit:test name="route_getProducts" description="GET /products goes to papi-orders GET /products">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="xapi-online-store-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-papi-orders"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- { requestId: '30000000-0000-4000-8000-000000000042', ok: true }]" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 200, headers: { 'content-type': 'application/json' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:spy processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-papi-orders"/>
				</munit-tools:with-attributes>
				<munit-tools:before-call>
					<munit-tools:assert-that expression="#[output application/java --- vars.call.method]" is="#[MunitTools::equalTo('GET')]"/>
					<munit-tools:assert-that expression="#[output application/java --- vars.call.path]" is="#[MunitTools::equalTo('/products')]"/>
					<munit-tools:assert-that expression="#[output application/java --- vars.call.query.size]" is="#[MunitTools::equalTo('20')]"/>
				</munit-tools:before-call>
			</munit-tools:spy>
		</munit:behavior>
		<munit:execution>
			<http:request method="GET" config-ref="test-api-client" path="/api/v1/online-store/products?page=1&amp;size=20">
				<http:headers><![CDATA[#[{ client_id: 'tienda-web', client_secret: 'secret', 'Content-Type': 'application/json' }]]]></http:headers>
				<http:response-validator><http:success-status-code-validator values="0..599"/></http:response-validator>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- attributes.statusCode]" is="#[MunitTools::equalTo(200)]"/>
			<munit-tools:assert-that expression="#[output application/java --- payload.ok]" is="#[MunitTools::equalTo(true)]"/>
			<munit-tools:verify-call processor="http:request" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-papi-orders"/>
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>


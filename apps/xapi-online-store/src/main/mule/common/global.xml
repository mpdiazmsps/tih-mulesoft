<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:api-gateway="http://www.mulesoft.org/schema/mule/api-gateway"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/api-gateway http://www.mulesoft.org/schema/mule/api-gateway/current/mule-api-gateway.xsd
		http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">

	<global-property name="env" value="local"
		doc:name="Global Property"
		doc:description="Active environment: local by default; CloudHub passes env=cloud"/>

	<configuration-properties file="properties/${env}-application-config.yaml"
		doc:name="Configuration properties"
		doc:description="Environment properties: listener, Process APIs, API Manager instance and Retry-After"/>

	<configuration defaultErrorHandler-ref="global-error-handler"
		doc:name="Configuration"
		doc:description="Global error handler: turns any error of the Experience API itself into the contract ErrorResponse"/>

	<!-- API Manager instance (Client ID Enforcement for the store, the approver and the traffic generator).
	     Locally the runtime has no platform credentials, so the gateway stays off and the API is not blocked. -->
	<api-gateway:autodiscovery apiId="${api.autodiscovery.id}" ignoreBasePath="true" flowRef="xapi-online-store-main"
		doc:name="API Autodiscovery"
		doc:description="Links the application to its API Manager instance, where the policies are applied"/>

	<http:listener-config name="xapi-online-store-httpListenerConfig"
		doc:name="HTTP Listener config"
		doc:description="API HTTP listener. Host and port come from the environment properties">
		<http:listener-connection host="${http.listener.host}" port="${http.listener.port}"
			doc:description="Opens the environment HTTP port; on CloudHub the load balancer terminates TLS"/>
	</http:listener-config>

	<http:request-config name="papi-customers-http-config" basePath="${papi.customers.basePath}" responseTimeout="${papi.timeoutMillis}"
		doc:name="papi-customers-http-config" doc:description="HTTP client for papi-customers">
		<http:request-connection protocol="${papi.customers.protocol}" host="${papi.customers.host}" port="${papi.customers.port}"/>
		<http:default-headers>
			<http:default-header key="client_id" value="${papi.clientId}"/>
			<http:default-header key="client_secret" value="${papi.clientSecret}"/>
		</http:default-headers>
	</http:request-config>

	<http:request-config name="papi-orders-http-config" basePath="${papi.orders.basePath}" responseTimeout="${papi.timeoutMillis}"
		doc:name="papi-orders-http-config" doc:description="HTTP client for papi-orders">
		<http:request-connection protocol="${papi.orders.protocol}" host="${papi.orders.host}" port="${papi.orders.port}"/>
		<http:default-headers>
			<http:default-header key="client_id" value="${papi.clientId}"/>
			<http:default-header key="client_secret" value="${papi.clientSecret}"/>
		</http:default-headers>
	</http:request-config>

	<http:request-config name="papi-order-requests-http-config" basePath="${papi.orderRequests.basePath}" responseTimeout="${papi.timeoutMillis}"
		doc:name="papi-order-requests-http-config" doc:description="HTTP client for papi-order-requests">
		<http:request-connection protocol="${papi.orderRequests.protocol}" host="${papi.orderRequests.host}" port="${papi.orderRequests.port}"/>
		<http:default-headers>
			<http:default-header key="client_id" value="${papi.clientId}"/>
			<http:default-header key="client_secret" value="${papi.clientSecret}"/>
		</http:default-headers>
	</http:request-config>

	<!-- Global handler (enabled through defaultErrorHandler-ref). It only translates errors: no business logic. -->
	<error-handler name="global-error-handler"
		doc:name="Error Handler"
		doc:description="Turns any error into the contract ErrorResponse with the matching HTTP status">
		<on-error-propagate type="ANY" enableNotifications="true" logException="false"
			doc:name="On Error Propagate"
			doc:description="Handles APIkit errors and unreachable Process APIs">
			<logger level="ERROR"
				message="#['ERROR - ' ++ (error.errorType.namespace default 'MULE') ++ ':' ++ (error.errorType.identifier default 'ANY') ++ ' - ' ++ (error.description default '') ++ ' correlationId: ' ++ correlationId]"
				doc:name="logger-global-error"
				doc:description="Logs the error type, its description and the correlationId"/>
			<ee:transform doc:name="transform-resolve-error-info"
				doc:description="Resolves HTTP status, code, message and retryable flag from the error type">
				<ee:message/>
				<ee:variables>
					<ee:set-variable variableName="errorInfo" resource="dataweave/mapping-error-info.dwl"/>
				</ee:variables>
			</ee:transform>
			<ee:transform doc:name="transform-build-error-response"
				doc:description="Builds the ErrorResponse, the HTTP status and the Retry-After header when the error is a 503">
				<ee:message>
					<ee:set-payload resource="dataweave/mapping-error-response.dwl"/>
				</ee:message>
				<ee:variables>
					<ee:set-variable variableName="httpStatus"><![CDATA[%dw 2.0
output application/java
---
vars.errorInfo.status]]></ee:set-variable>
					<ee:set-variable variableName="outboundHeaders"><![CDATA[%dw 2.0
output application/java
---
if (vars.errorInfo.status == 503) { "Retry-After": p('error.retryAfterSeconds') } else {}]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
		</on-error-propagate>
	</error-handler>

</mule>

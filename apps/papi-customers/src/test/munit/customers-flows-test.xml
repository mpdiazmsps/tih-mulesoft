	<munit:test name="getByIds_passesBatchToCrm" description="A batch of ids is passed to sapi-crm in one single call">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-crm-contacts"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- [ { id: '003Hs00000CUMBRAAA', name: 'Constructora Cumbres', email: 'compras@cumbres.ejemplo.mx', phone: '+528181234567', segment: 'STRATEGIC', address: { street: 'Av. Constitución 100', city: 'Monterrey', postalCode: '64000' } }, { id: '003Hs00000TAPATAAA', name: 'Grupo Hotelero Tapatío', segment: 'STRATEGIC', address: { city: 'Guadalajara' } } ]]" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 200, headers: { 'content-type': 'application/json' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:attributes value="#[{ queryParams: { ids: '003Hs00000CUMBRAAA,003Hs00000TAPATAAA' } }]"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="customers-list-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[output application/java --- sizeOf(payload)]" is="#[MunitTools::equalTo(2)]"/>
			<munit-tools:assert-that expression="#[output application/java --- vars.crmQuery.params.ids]" is="#[MunitTools::equalTo('003Hs00000CUMBRAAA,003Hs00000TAPATAAA')]"/>
			<munit-tools:verify-call processor="http:request" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-crm-contacts"/>
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>


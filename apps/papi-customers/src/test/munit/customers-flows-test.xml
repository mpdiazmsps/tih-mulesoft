	<munit:test name="get_unknown_returns404" description="sapi-crm answers 404: CUSTOMER_NOT_FOUND" expectedErrorType="APP:CUSTOMER_NOT_FOUND">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-crm-contact"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="HTTP:NOT_FOUND"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:attributes value="#[{ uriParams: { customerId: '003Hs00000NOEXIAAA' } }]"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="customers-get-flow"/>
		</munit:execution>
	</munit:test>


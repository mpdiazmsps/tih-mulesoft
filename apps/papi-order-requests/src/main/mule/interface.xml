<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
		http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd">

	<apikit:config name="papi-order-requests-config"
		api="resource::9885f017-0660-4c80-a27f-eb006d124bd8:papi-order-requests:1.0.0:raml:zip:papi-order-requests.raml"
		outboundHeadersMapName="outboundHeaders"
		httpStatusVarName="httpStatus"
		doc:name="APIkit Router config"
		doc:description="Validates each request against the papi-order-requests RAML and routes it to its interface flow"/>

	<flow name="papi-order-requests-main"
		doc:name="papi-order-requests-main"
		doc:description="HTTP entry point. Errors are handled by the global error handler">
		<http:listener config-ref="papi-order-requests-httpListenerConfig" path="${http.listener.basePath}/*"
			doc:name="Listener"
			doc:description="Receives requests on the API base path">
			<http:response statusCode="#[vars.httpStatus default 200]">
				<http:headers>#[vars.outboundHeaders default {}]</http:headers>
			</http:response>
			<http:error-response statusCode="#[vars.httpStatus default 500]">
				<http:body>#[payload]</http:body>
				<http:headers>#[vars.outboundHeaders default {}]</http:headers>
			</http:error-response>
		</http:listener>
		<apikit:router config-ref="papi-order-requests-config"
			doc:name="APIkit Router"
			doc:description="Routes the request to the interface flow matching the RAML method and resource"/>
	</flow>

	<!-- Interface flows with the APIkit scaffolding names: they only delegate to the implementation. Do not rename. -->

	<flow name="post:\order-requests:application\json:papi-order-requests-config" doc:name="post:\order-requests" doc:description="Request a correction">
		<flow-ref name="requests-create-flow" doc:name="requests-create-flow" doc:description="Delegates to the request creation"/>
	</flow>

	<flow name="get:\order-requests:papi-order-requests-config" doc:name="get:\order-requests" doc:description="List requests by status">
		<flow-ref name="requests-list-flow" doc:name="requests-list-flow" doc:description="Delegates to the request listing"/>
	</flow>

	<flow name="get:\order-requests\(requestId):papi-order-requests-config" doc:name="get:\order-requests\(requestId)" doc:description="Get request">
		<flow-ref name="requests-get-flow" doc:name="requests-get-flow" doc:description="Delegates to the request lookup"/>
	</flow>

	<flow name="post:\order-requests\(requestId)\approve:papi-order-requests-config" doc:name="post:\order-requests\(requestId)\approve" doc:description="Approve">
		<flow-ref name="requests-approve-flow" doc:name="requests-approve-flow" doc:description="Delegates to the approval"/>
	</flow>

	<flow name="post:\order-requests\(requestId)\reject:application\json:papi-order-requests-config" doc:name="post:\order-requests\(requestId)\reject" doc:description="Reject">
		<flow-ref name="requests-reject-flow" doc:name="requests-reject-flow" doc:description="Delegates to the rejection"/>
	</flow>

	<flow name="post:\order-requests\(requestId)\retry:papi-order-requests-config" doc:name="post:\order-requests\(requestId)\retry" doc:description="Retry a failed request">
		<flow-ref name="requests-retry-flow" doc:name="requests-retry-flow" doc:description="Delegates to the retry"/>
	</flow>

</mule>

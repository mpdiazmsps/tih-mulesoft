	<munit:test name="getPrice_unknownProduct_returns404" description="Provider A answers 200 with an empty body for an unknown id: PRODUCT_NOT_FOUND" expectedErrorType="APP:PRODUCT_NOT_FOUND">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>

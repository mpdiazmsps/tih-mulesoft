<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
	xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
		http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

	<!-- Per-flow tests for sapi-price-providers (task 12). Providers are mocked by the doc:name of each connector.
	     Each test keeps every provider below 3 failures so no circuit opens inside the suite.
	     Generated by a script; the data comes from the demo script (data/scenario.json). -->
	<munit:config name="price-flows-test.xml"/>

	<!-- resilience-call reaches the provider flows through a dynamic flow-ref: MUnit needs a static reference. -->
	<munit:before-suite name="price-flows-static-references" description="Static references to the provider read flows">
		<choice>
			<when expression="#[false]">
				<flow-ref name="provider-fak-quote-subflow"/>
				<flow-ref name="provider-esc-quote-subflow"/>
				<flow-ref name="provider-bor-quote-subflow"/>
			</when>
		</choice>
	</munit:before-suite>

	<!-- ===================================================== Mocked provider C responses -->
	<flow name="mock-bor-sku100-flow">
		<ee:transform>
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/java
---
{ headers: {}, attachments: {}, body: read('<GetArticleByIdResponse xmlns="http://tempuri.org/"><GetArticleByIdResult><ArticleId>3</ArticleId><Name>Producto 100</Name><Price>175.00</Price><Currency>MXN</Currency></GetArticleByIdResult></GetArticleByIdResponse>', 'application/xml') }]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</flow>

	<flow name="mock-bor-empty-flow">
		<ee:transform>
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/java
---
{ headers: {}, attachments: {}, body: read('<GetArticleByIdResponse xmlns="http://tempuri.org/"/>', 'application/xml') }]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</flow>

	<munit:test name="quotes_sku100_threeQuotesMxn" description="SKU-100 with the three providers: 189.00 FAK, 194.00 ESC and 175.00 BOR, all in MXN, and noResponse empty">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-provider-fak"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- { id: 7, title: 'Producto 100', price: 189, currency: 'MXN' }]" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 200, headers: { 'content-type': 'application/json' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-provider-esc"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- { id: 122, title: 'Producto 100', price: 194, currency: 'MXN', category: { id: 1, name: 'general' } }]" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 200, headers: { 'content-type': 'application/json' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="wsc:consume">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="wsc-consume-provider-bor"/>
				</munit-tools:with-attributes>
				<munit-tools:then-call flow="mock-bor-sku100-flow"/>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:payload value="#[output application/json --- [ { abv: 'FAK', externalId: 7 }, { abv: 'ESC', externalId: 122 }, { abv: 'BOR', externalId: 3 } ]]" mediaType="application/json"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="quotes-post-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[sizeOf(payload.quotes)]" is="#[MunitTools::equalTo(3)]"/>
			<munit-tools:assert-that expression="#[payload.noResponse]" is="#[MunitTools::equalTo([])]"/>
			<munit-tools:assert-that expression="#[(payload.quotes filter ((x) -> x.abv == 'FAK'))[0].price]" is="#[MunitTools::equalTo(189)]"/>
			<munit-tools:assert-that expression="#[(payload.quotes filter ((x) -> x.abv == 'ESC'))[0].price]" is="#[MunitTools::equalTo(194)]"/>
			<munit-tools:assert-that expression="#[(payload.quotes filter ((x) -> x.abv == 'BOR'))[0].price]" is="#[MunitTools::equalTo(175)]"/>
			<munit-tools:assert-that expression="#[payload.quotes.currency distinctBy $]" is="#[MunitTools::equalTo(['MXN'])]"/>
			<munit-tools:assert-that expression="#[(payload.quotes filter ((x) -> x.abv == 'BOR'))[0].name]" is="#[MunitTools::equalTo('Producto 100')]"/>
			<munit-tools:assert-that expression="#[(payload.quotes filter ((x) -> x.abv == 'ESC'))[0].externalId]" is="#[MunitTools::equalTo(122)]"/>
			<munit-tools:assert-that expression="#[(payload.quotes filter ((x) -> x.abv == 'FAK'))[0].quotedAt]" is="#[MunitTools::endsWith('Z')]"/>
		</munit:validation>
	</munit:test>

	<munit:test name="quotes_providerCTimeout_twoQuotesAndCInNoResponse" description="Provider C times out (WSC:TIMEOUT): two quotes and BOR in noResponse with reason TIMEOUT, without a retry">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-provider-fak"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- { id: 7, title: 'Producto 100', price: 189, currency: 'MXN' }]" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 200, headers: { 'content-type': 'application/json' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-provider-esc"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- { id: 122, title: 'Producto 100', price: 194, currency: 'MXN', category: { id: 1, name: 'general' } }]" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 200, headers: { 'content-type': 'application/json' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="wsc:consume">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="wsc-consume-provider-bor"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="WSC:TIMEOUT"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:payload value="#[output application/json --- [ { abv: 'FAK', externalId: 7 }, { abv: 'ESC', externalId: 122 }, { abv: 'BOR', externalId: 3 } ]]" mediaType="application/json"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="quotes-post-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[sizeOf(payload.quotes)]" is="#[MunitTools::equalTo(2)]"/>
			<munit-tools:assert-that expression="#[payload.quotes.abv]" is="#[MunitTools::equalTo(['FAK', 'ESC'])]"/>
			<munit-tools:assert-that expression="#[payload.noResponse]" is="#[MunitTools::equalTo([{ abv: 'BOR', externalId: 3, reason: 'TIMEOUT' }])]"/>
			<munit-tools:verify-call processor="wsc:consume" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="wsc-consume-provider-bor"/>
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>

	<munit:test name="quotes_unknownProducts_notFoundInNoResponse" description="Unknown ids (A empty body, B 400, C without result) are not failures: no quotes and the three in noResponse as NOT_FOUND">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-provider-fak"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#['']" mediaType="application/json"/>
					<munit-tools:attributes value="#[{ statusCode: 200, headers: { 'content-length': '0', 'content-type': 'application/json' } }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-provider-esc"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="HTTP:BAD_REQUEST"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="wsc:consume">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="wsc-consume-provider-bor"/>
				</munit-tools:with-attributes>
				<munit-tools:then-call flow="mock-bor-empty-flow"/>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:payload value="#[output application/json --- [ { abv: 'FAK', externalId: 9999 }, { abv: 'ESC', externalId: 9999 }, { abv: 'BOR', externalId: 9999 } ]]" mediaType="application/json"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="quotes-post-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[payload.quotes]" is="#[MunitTools::equalTo([])]"/>
			<munit-tools:assert-that expression="#[payload.noResponse.reason]" is="#[MunitTools::equalTo(['NOT_FOUND', 'NOT_FOUND', 'NOT_FOUND'])]"/>
		</munit:validation>
	</munit:test>


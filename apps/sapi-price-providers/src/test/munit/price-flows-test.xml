	<munit:test name="getPrice_bor_returnsQuoteWithProviderCurrency" description="Provider C returns the quote with the currency read from its response">
		<munit:behavior>
			<munit-tools:mock-when processor="wsc:consume">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="wsc-consume-provider-bor"/>
				</munit-tools:with-attributes>
				<munit-tools:then-call flow="mock-bor-sku100-flow"/>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:attributes value="#[{ uriParams: { providerAbv: 'BOR', externalId: '3' } }]"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="price-get-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[payload.abv]" is="#[MunitTools::equalTo('BOR')]"/>
			<munit-tools:assert-that expression="#[payload.externalId]" is="#[MunitTools::equalTo(3)]"/>
			<munit-tools:assert-that expression="#[payload.price]" is="#[MunitTools::equalTo(175)]"/>
			<munit-tools:assert-that expression="#[payload.currency]" is="#[MunitTools::equalTo('MXN')]"/>
		</munit:validation>
	</munit:test>

	<munit:test name="getPrice_escTimeout_returns503" description="Provider B times out: PROVIDER_UNAVAILABLE (503) and the request is not retried">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-provider-esc"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="HTTP:TIMEOUT"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:attributes value="#[{ uriParams: { providerAbv: 'ESC', externalId: '122' } }]"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<try>
				<flow-ref name="price-get-flow"/>
				<error-handler>
					<on-error-continue type="APP:PROVIDER_UNAVAILABLE" logException="false">
						<set-variable variableName="caughtError" value="#[error.errorType.namespace ++ ':' ++ error.errorType.identifier]"/>
					</on-error-continue>
				</error-handler>
			</try>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[vars.caughtError]" is="#[MunitTools::equalTo('APP:PROVIDER_UNAVAILABLE')]"/>
			<munit-tools:verify-call processor="http:request" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-provider-esc"/>
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>

	<munit:test name="getPrice_fakConnectivity_retriesOnceThen503" description="Provider A refuses the connection: retried exactly once (2 calls), then PROVIDER_UNAVAILABLE (503)">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-provider-fak"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="HTTP:CONNECTIVITY"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:attributes value="#[{ uriParams: { providerAbv: 'FAK', externalId: '7' } }]"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<try>
				<flow-ref name="price-get-flow"/>
				<error-handler>
					<on-error-continue type="APP:PROVIDER_UNAVAILABLE" logException="false">
						<set-variable variableName="caughtError" value="#[error.errorType.namespace ++ ':' ++ error.errorType.identifier]"/>
					</on-error-continue>
				</error-handler>
			</try>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[vars.caughtError]" is="#[MunitTools::equalTo('APP:PROVIDER_UNAVAILABLE')]"/>
			<munit-tools:verify-call processor="http:request" times="2">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-provider-fak"/>
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>


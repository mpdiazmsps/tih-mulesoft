<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
	xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

	<munit:config name="customers-create-flow-test.xml"/>

	<!-- Flujo auxiliar: simula el error que lanza Oracle al violar la unicidad del email (ORA-00001)
	     y aplica el manejador real db-customer-constraint-handler. -->
	<flow name="test-customer-unique-violation-flow">
		<raise-error type="APP:TEST" description="ORA-00001: unique constraint (STORE_APP.UQ_CUSTOMERS_EMAIL) violated"/>
		<error-handler ref="db-customer-constraint-handler"/>
	</flow>

	<!-- Flujo auxiliar: un error de Oracle que no es de unicidad no debe traducirse. -->
	<flow name="test-customer-other-error-flow">
		<raise-error type="APP:TEST" description="ORA-12899: value too large for column"/>
		<error-handler ref="db-customer-constraint-handler"/>
	</flow>

	<!-- Propósito: POST /customers inserta el cliente y responde 201 con el Customer.
	     Escenario: cliente completo, Oracle (mock) acepta el insert. Resultado esperado: 201, mismos datos y fecha en UTC. -->
	<munit:test name="customersCreate_whenValidCustomer_thenReturn201WithCustomer"
		description="Crea el cliente y responde 201 con sus datos">
		<munit:behavior>
			<munit-tools:mock-when processor="db:insert">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="db-insert-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/java --- { affectedRows: 1 }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<munit:set-event>
				<munit:payload value="#[output application/json --- readUrl('classpath://payloads/customer-create-request.json', 'application/json')]" mediaType="application/json"/>
			</munit:set-event>
			<flow-ref name="post:\customers:application\json:sapi-oracle-core-tih-config"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[vars.httpStatus]" is="#[MunitTools::equalTo(201)]"/>
			<munit-tools:assert-that expression="#[payload.id]" is="#[MunitTools::equalTo('3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c')]"/>
			<munit-tools:assert-that expression="#[payload.name]" is="#[MunitTools::equalTo('Ana')]"/>
			<munit-tools:assert-that expression="#[payload.email]" is="#[MunitTools::equalTo('ana.perez@example.com')]"/>
			<munit-tools:assert-that expression="#[payload.creationDate]" is="#[MunitTools::equalTo('2026-10-07T16:30:00Z')]"/>
			<munit-tools:verify-call processor="db:insert" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="db-insert-customer"/>
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>

	<!-- Propósito: los campos opcionales ausentes no se inventan en la respuesta.
	     Escenario: cliente solo con teléfono. Resultado esperado: 201 sin email ni lastName. -->
	<munit:test name="customersCreate_whenOnlyPhoneProvided_thenOmitMissingFields"
		description="Crea un cliente sin email ni apellido">
		<munit:behavior>
			<munit-tools:mock-when processor="db:insert">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="db-insert-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/java --- { affectedRows: 1 }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<munit:set-event>
				<munit:payload value="#[output application/json --- readUrl('classpath://payloads/customer-create-phone-only-request.json', 'application/json')]" mediaType="application/json"/>
			</munit:set-event>
			<flow-ref name="post:\customers:application\json:sapi-oracle-core-tih-config"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[vars.httpStatus]" is="#[MunitTools::equalTo(201)]"/>
			<munit-tools:assert-that expression="#[payload.phone]" is="#[MunitTools::equalTo('+5215500000000')]"/>
			<munit-tools:assert-that expression="#[payload.email]" is="#[MunitTools::nullValue()]"/>
			<munit-tools:assert-that expression="#[payload.lastName]" is="#[MunitTools::nullValue()]"/>
		</munit:validation>
	</munit:test>

	<!-- Propósito: un email duplicado en Oracle se traduce en el error de negocio que se responde como 409.
	     Escenario: ORA-00001 sobre UQ_CUSTOMERS_EMAIL. Resultado esperado: APP:CUSTOMER_ALREADY_EXISTS. -->
	<munit:test name="customersCreate_whenEmailViolatesUniqueConstraint_thenRaiseCustomerAlreadyExists"
		description="Traduce ORA-00001 en APP:CUSTOMER_ALREADY_EXISTS"
		expectedErrorType="APP:CUSTOMER_ALREADY_EXISTS">
		<munit:execution>
			<flow-ref name="test-customer-unique-violation-flow"/>
		</munit:execution>
	</munit:test>

	<!-- Propósito: otros errores de Oracle no se disfrazan de duplicado.
	     Escenario: ORA-12899. Resultado esperado: el error original sigue su camino. -->
	<munit:test name="customersCreate_whenOtherDatabaseErrorOccurs_thenKeepOriginalError"
		description="No traduce errores que no son de unicidad"
		expectedErrorType="APP:TEST">
		<munit:execution>
			<flow-ref name="test-customer-other-error-flow"/>
		</munit:execution>
	</munit:test>

	<!-- Propósito: la alta pasa por el manejador del flujo cuando el insert falla.
	     Escenario: db:insert falla con DB:CONNECTIVITY. Resultado esperado: el error se propaga (503 en el manejador global). -->
	<munit:test name="customersCreate_whenDatabaseIsDown_thenPropagateConnectivityError"
		description="Propaga DB:CONNECTIVITY cuando Oracle no está disponible"
		expectedErrorType="DB:CONNECTIVITY">
		<munit:behavior>
			<munit-tools:mock-when processor="db:insert">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="db-insert-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="DB:CONNECTIVITY"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<munit:set-event>
				<munit:payload value="#[output application/json --- readUrl('classpath://payloads/customer-create-request.json', 'application/json')]" mediaType="application/json"/>
			</munit:set-event>
			<flow-ref name="post:\customers:application\json:sapi-oracle-core-tih-config"/>
		</munit:execution>
	</munit:test>

</mule>

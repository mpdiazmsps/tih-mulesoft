<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
	xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

	<munit:config name="global-error-handlers-test.xml"/>

	<!-- Flujo auxiliar: provoca el error indicado en vars.scenario, lo atrapa y ejecuta los mismos scripts de
	     DataWeave que usa global-error-handler para construir el ErrorResponse. Así se puede comprobar el
	     catálogo de errores (estado, código, mensaje, retryable) sin que el error siga propagándose. -->
	<flow name="test-resolve-error-flow">
		<try>
			<choice>
				<when expression="#[vars.scenario == 'customer-not-found']">
					<raise-error type="APP:CUSTOMER_NOT_FOUND" description="El cliente no está registrado"/>
				</when>
				<when expression="#[vars.scenario == 'customer-conflict']">
					<raise-error type="APP:CUSTOMER_ALREADY_EXISTS" description="Ya existe un cliente con ese email o id"/>
				</when>
				<when expression="#[vars.scenario == 'order-conflict']">
					<raise-error type="APP:ORDER_ALREADY_EXISTS" description="Ya existe un pedido con ese id"/>
				</when>
				<when expression="#[vars.scenario == 'order-not-found']">
					<raise-error type="APP:ORDER_NOT_FOUND" description="El pedido no existe"/>
				</when>
				<when expression="#[vars.scenario == 'validation']">
					<raise-error type="APP:VALIDATION_ERROR" description="Se requiere al menos un filtro: email o phone"/>
				</when>
				<when expression="#[vars.scenario == 'database-down']">
					<flow-ref name="customers-get-by-id-flow"/>
				</when>
				<otherwise>
					<raise-error type="MULE:EXPRESSION" description="detalle interno que no debe llegar al consumidor"/>
				</otherwise>
			</choice>
			<error-handler>
				<on-error-continue>
					<ee:transform>
						<ee:message/>
						<ee:variables>
							<ee:set-variable variableName="errorInfo" resource="dataweave/mapping-error-info.dwl"/>
						</ee:variables>
					</ee:transform>
					<ee:transform>
						<ee:message>
							<ee:set-payload resource="dataweave/mapping-error-response.dwl"/>
						</ee:message>
					</ee:transform>
				</on-error-continue>
			</error-handler>
		</try>
	</flow>

	<!-- Propósito: un cliente inexistente responde 404 con el código del contrato y el mensaje de negocio.
	     Resultado esperado: status 404, code CUSTOMER_NOT_FOUND, retryable false. -->
	<munit:test name="errorCatalog_whenCustomerNotFound_thenMapTo404"
		description="APP:CUSTOMER_NOT_FOUND se traduce en 404">
		<munit:execution>
			<munit:set-event>
				<munit:variables>
					<munit:variable key="scenario" value="customer-not-found"/>
				</munit:variables>
			</munit:set-event>
			<flow-ref name="test-resolve-error-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[vars.errorInfo.status]" is="#[MunitTools::equalTo(404)]"/>
			<munit-tools:assert-that expression="#[payload.code]" is="#[MunitTools::equalTo('CUSTOMER_NOT_FOUND')]"/>
			<munit-tools:assert-that expression="#[payload.message]" is="#[MunitTools::equalTo('El cliente no está registrado')]"/>
			<munit-tools:assert-that expression="#[payload.retryable]" is="#[MunitTools::equalTo(false)]"/>
			<munit-tools:assert-that expression="#[payload.correlationId]" is="#[MunitTools::notNullValue()]"/>
			<munit-tools:assert-that expression="#[payload.timestamp]" is="#[MunitTools::endsWith('Z')]"/>
		</munit:validation>
	</munit:test>

	<!-- Propósito: duplicados responden 409. Resultado esperado: status 409 para cliente y para pedido. -->
	<munit:test name="errorCatalog_whenCustomerAlreadyExists_thenMapTo409"
		description="APP:CUSTOMER_ALREADY_EXISTS se traduce en 409">
		<munit:execution>
			<munit:set-event>
				<munit:variables>
					<munit:variable key="scenario" value="customer-conflict"/>
				</munit:variables>
			</munit:set-event>
			<flow-ref name="test-resolve-error-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[vars.errorInfo.status]" is="#[MunitTools::equalTo(409)]"/>
			<munit-tools:assert-that expression="#[payload.code]" is="#[MunitTools::equalTo('CUSTOMER_ALREADY_EXISTS')]"/>
			<munit-tools:assert-that expression="#[payload.retryable]" is="#[MunitTools::equalTo(false)]"/>
		</munit:validation>
	</munit:test>

	<munit:test name="errorCatalog_whenOrderAlreadyExists_thenMapTo409"
		description="APP:ORDER_ALREADY_EXISTS se traduce en 409">
		<munit:execution>
			<munit:set-event>
				<munit:variables>
					<munit:variable key="scenario" value="order-conflict"/>
				</munit:variables>
			</munit:set-event>
			<flow-ref name="test-resolve-error-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[vars.errorInfo.status]" is="#[MunitTools::equalTo(409)]"/>
			<munit-tools:assert-that expression="#[payload.code]" is="#[MunitTools::equalTo('ORDER_ALREADY_EXISTS')]"/>
		</munit:validation>
	</munit:test>

	<munit:test name="errorCatalog_whenOrderNotFound_thenMapTo404"
		description="APP:ORDER_NOT_FOUND se traduce en 404">
		<munit:execution>
			<munit:set-event>
				<munit:variables>
					<munit:variable key="scenario" value="order-not-found"/>
				</munit:variables>
			</munit:set-event>
			<flow-ref name="test-resolve-error-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[vars.errorInfo.status]" is="#[MunitTools::equalTo(404)]"/>
			<munit-tools:assert-that expression="#[payload.code]" is="#[MunitTools::equalTo('ORDER_NOT_FOUND')]"/>
		</munit:validation>
	</munit:test>

	<!-- Propósito: los errores de validación muestran al consumidor la descripción que escribió el negocio.
	     Resultado esperado: status 400 y el mensaje de la descripción. -->
	<munit:test name="errorCatalog_whenValidationError_thenMapTo400WithDescription"
		description="APP:VALIDATION_ERROR se traduce en 400 con su descripción">
		<munit:execution>
			<munit:set-event>
				<munit:variables>
					<munit:variable key="scenario" value="validation"/>
				</munit:variables>
			</munit:set-event>
			<flow-ref name="test-resolve-error-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[vars.errorInfo.status]" is="#[MunitTools::equalTo(400)]"/>
			<munit-tools:assert-that expression="#[payload.code]" is="#[MunitTools::equalTo('VALIDATION_ERROR')]"/>
			<munit-tools:assert-that expression="#[payload.message]" is="#[MunitTools::equalTo('Se requiere al menos un filtro: email o phone')]"/>
		</munit:validation>
	</munit:test>

	<!-- Propósito: si Oracle no está disponible el consumidor recibe 503 reintentable.
	     Escenario: db:select falla con DB:CONNECTIVITY. Resultado esperado: 503, SERVICE_UNAVAILABLE, retryable true. -->
	<munit:test name="errorCatalog_whenDatabaseConnectivityFails_thenMapTo503Retryable"
		description="DB:CONNECTIVITY se traduce en 503 reintentable">
		<munit:behavior>
			<munit-tools:mock-when processor="db:select">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="db-select-customer-by-id"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="DB:CONNECTIVITY"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<munit:set-event>
				<munit:variables>
					<munit:variable key="scenario" value="database-down"/>
				</munit:variables>
				<munit:attributes value="#[{ uriParams: { customerId: '3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c' } }]"/>
			</munit:set-event>
			<flow-ref name="test-resolve-error-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[vars.errorInfo.status]" is="#[MunitTools::equalTo(503)]"/>
			<munit-tools:assert-that expression="#[payload.code]" is="#[MunitTools::equalTo('SERVICE_UNAVAILABLE')]"/>
			<munit-tools:assert-that expression="#[payload.retryable]" is="#[MunitTools::equalTo(true)]"/>
		</munit:validation>
	</munit:test>

	<!-- Propósito: un error inesperado responde 500 genérico sin filtrar detalles internos al consumidor.
	     Resultado esperado: status 500, INTERNAL_ERROR y el mensaje genérico (no la descripción interna). -->
	<munit:test name="errorCatalog_whenUnexpectedError_thenMapTo500WithoutInternalDetails"
		description="Un error desconocido se traduce en 500 sin detalles internos">
		<munit:execution>
			<munit:set-event>
				<munit:variables>
					<munit:variable key="scenario" value="unexpected"/>
				</munit:variables>
			</munit:set-event>
			<flow-ref name="test-resolve-error-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[vars.errorInfo.status]" is="#[MunitTools::equalTo(500)]"/>
			<munit-tools:assert-that expression="#[payload.code]" is="#[MunitTools::equalTo('INTERNAL_ERROR')]"/>
			<munit-tools:assert-that expression="#[payload.message]" is="#[MunitTools::equalTo('Error inesperado')]"/>
			<munit-tools:assert-that expression="#[payload.message contains 'interno']" is="#[MunitTools::equalTo(false)]"/>
		</munit:validation>
	</munit:test>

</mule>

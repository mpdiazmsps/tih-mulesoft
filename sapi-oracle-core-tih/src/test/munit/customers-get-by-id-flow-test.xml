<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
	xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

	<munit:config name="customers-get-by-id-flow-test.xml"/>

	<!-- Propósito: GET /customers/{customerId} devuelve el Customer del contrato cuando la fila existe.
	     Escenario: Oracle (mock) devuelve una fila de CUSTOMERS. Resultado esperado: Customer sin campos NULL. -->
	<munit:test name="customersGetById_whenCustomerExists_thenReturnCustomer"
		description="Devuelve el cliente cuando existe en CUSTOMERS">
		<munit:behavior>
			<munit-tools:mock-when processor="db:select">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="db-select-customer-by-id"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/java --- readUrl('classpath://payloads/customer-rows.json', 'application/json')]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<munit:set-event>
				<munit:attributes value="#[{ uriParams: { customerId: '3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c' } }]"/>
			</munit:set-event>
			<flow-ref name="get:\customers\(customerId):sapi-oracle-core-tih-config"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[payload.id]" is="#[MunitTools::equalTo('3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c')]"/>
			<munit-tools:assert-that expression="#[payload.name]" is="#[MunitTools::equalTo('Ana')]"/>
			<munit-tools:assert-that expression="#[payload.email]" is="#[MunitTools::equalTo('ana.perez@example.com')]"/>
			<munit-tools:assert-that expression="#[payload.creationDate]" is="#[MunitTools::equalTo('2026-10-07T16:30:00.000Z')]"/>
			<munit-tools:verify-call processor="db:select" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="db-select-customer-by-id"/>
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>

	<!-- Propósito: los campos opcionales NULL de Oracle no deben aparecer en la respuesta.
	     Escenario: fila con apellido, correo y teléfono NULL. Resultado esperado: Customer solo con id, name y creationDate. -->
	<munit:test name="customersGetById_whenOptionalColumnsAreNull_thenOmitThem"
		description="Omite lastName, email y phone cuando son NULL">
		<munit:behavior>
			<munit-tools:mock-when processor="db:select">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="db-select-customer-by-id"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/java --- [{ ID: 'c1', CLIENT_NAME: 'Luis', CLIENT_LAST_NAME: null, CLIENT_EMAIL: null, CLIENT_PHONE: null, CREATION_DATE: '20261007163000000' }]]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<munit:set-event>
				<munit:attributes value="#[{ uriParams: { customerId: 'c1' } }]"/>
			</munit:set-event>
			<flow-ref name="get:\customers\(customerId):sapi-oracle-core-tih-config"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[payload.name]" is="#[MunitTools::equalTo('Luis')]"/>
			<munit-tools:assert-that expression="#[payload.email]" is="#[MunitTools::nullValue()]"/>
			<munit-tools:assert-that expression="#[payload.phone]" is="#[MunitTools::nullValue()]"/>
			<munit-tools:assert-that expression="#[payload.lastName]" is="#[MunitTools::nullValue()]"/>
		</munit:validation>
	</munit:test>

	<!-- Propósito: un id inexistente se traduce en 404.
	     Escenario: Oracle (mock) devuelve cero filas. Resultado esperado: error de negocio APP:CUSTOMER_NOT_FOUND. -->
	<munit:test name="customersGetById_whenCustomerDoesNotExist_thenRaiseCustomerNotFound"
		description="Eleva APP:CUSTOMER_NOT_FOUND cuando no hay filas"
		expectedErrorType="APP:CUSTOMER_NOT_FOUND">
		<munit:behavior>
			<munit-tools:mock-when processor="db:select">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="db-select-customer-by-id"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/java --- []]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<munit:set-event>
				<munit:attributes value="#[{ uriParams: { customerId: '00000000-0000-0000-0000-000000000000' } }]"/>
			</munit:set-event>
			<flow-ref name="get:\customers\(customerId):sapi-oracle-core-tih-config"/>
		</munit:execution>
	</munit:test>

	<!-- Propósito: si Oracle no está disponible el error de conectividad llega intacto al manejador global (503).
	     Escenario: db:select falla con DB:CONNECTIVITY. Resultado esperado: el error DB:CONNECTIVITY se propaga. -->
	<munit:test name="customersGetById_whenDatabaseIsDown_thenPropagateConnectivityError"
		description="Propaga DB:CONNECTIVITY para que el manejador global responda 503"
		expectedErrorType="DB:CONNECTIVITY">
		<munit:behavior>
			<munit-tools:mock-when processor="db:select">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="db-select-customer-by-id"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="DB:CONNECTIVITY"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<munit:set-event>
				<munit:attributes value="#[{ uriParams: { customerId: '3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c' } }]"/>
			</munit:set-event>
			<flow-ref name="get:\customers\(customerId):sapi-oracle-core-tih-config"/>
		</munit:execution>
	</munit:test>

</mule>

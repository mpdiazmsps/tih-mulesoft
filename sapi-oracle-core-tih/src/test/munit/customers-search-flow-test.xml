<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
	xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

	<munit:config name="customers-search-flow-test.xml"/>

	<!-- Propósito: GET /customers con email devuelve los clientes coincidentes.
	     Escenario: Oracle (mock) devuelve una fila. Resultado esperado: CustomerList con un cliente. -->
	<munit:test name="customersSearch_whenEmailMatches_thenReturnCustomerList"
		description="Devuelve la lista de clientes cuando el email coincide">
		<munit:behavior>
			<munit-tools:mock-when processor="db:select">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="db-select-customers-by-contact"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/java --- readUrl('classpath://payloads/customer-rows.json', 'application/json')]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<munit:set-event>
				<munit:attributes value="#[{ queryParams: { email: 'ana.perez@example.com' } }]"/>
			</munit:set-event>
			<flow-ref name="get:\customers:sapi-oracle-core-tih-config"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[sizeOf(payload.customers)]" is="#[MunitTools::equalTo(1)]"/>
			<munit-tools:assert-that expression="#[payload.customers[0].email]" is="#[MunitTools::equalTo('ana.perez@example.com')]"/>
			<munit-tools:assert-that expression="#[payload.customers[0].phone]" is="#[MunitTools::equalTo('+5215512345678')]"/>
		</munit:validation>
	</munit:test>

	<!-- Propósito: la búsqueda solo por teléfono también es válida.
	     Escenario: solo llega phone. Resultado esperado: se consulta Oracle una vez y se devuelve la lista. -->
	<munit:test name="customersSearch_whenOnlyPhoneProvided_thenQueryOracleOnce"
		description="Acepta la búsqueda solo por teléfono">
		<munit:behavior>
			<munit-tools:mock-when processor="db:select">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="db-select-customers-by-contact"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/java --- readUrl('classpath://payloads/customer-rows.json', 'application/json')]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<munit:set-event>
				<munit:attributes value="#[{ queryParams: { phone: '+5215512345678' } }]"/>
			</munit:set-event>
			<flow-ref name="get:\customers:sapi-oracle-core-tih-config"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[payload.customers[0].id]" is="#[MunitTools::equalTo('3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c')]"/>
			<munit-tools:verify-call processor="db:select" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="db-select-customers-by-contact"/>
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>

	<!-- Propósito: sin coincidencias se responde 200 con lista vacía, no 404.
	     Escenario: Oracle (mock) devuelve cero filas. Resultado esperado: customers = []. -->
	<munit:test name="customersSearch_whenNothingMatches_thenReturnEmptyList"
		description="Devuelve una lista vacía cuando no hay coincidencias">
		<munit:behavior>
			<munit-tools:mock-when processor="db:select">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="db-select-customers-by-contact"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/java --- []]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<munit:set-event>
				<munit:attributes value="#[{ queryParams: { email: 'nadie@example.com' } }]"/>
			</munit:set-event>
			<flow-ref name="get:\customers:sapi-oracle-core-tih-config"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[sizeOf(payload.customers)]" is="#[MunitTools::equalTo(0)]"/>
		</munit:validation>
	</munit:test>

	<!-- Propósito: la búsqueda exige al menos un filtro.
	     Escenario: no llega ni email ni phone. Resultado esperado: APP:VALIDATION_ERROR y Oracle no se consulta. -->
	<munit:test name="customersSearch_whenNoFilterProvided_thenRaiseValidationError"
		description="Rechaza la búsqueda sin email ni phone"
		expectedErrorType="APP:VALIDATION_ERROR">
		<munit:execution>
			<munit:set-event>
				<munit:attributes value="#[{ queryParams: {} }]"/>
			</munit:set-event>
			<flow-ref name="get:\customers:sapi-oracle-core-tih-config"/>
		</munit:execution>
	</munit:test>

</mule>

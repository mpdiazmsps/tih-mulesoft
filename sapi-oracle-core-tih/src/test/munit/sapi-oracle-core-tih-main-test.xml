	</munit:test>

	<!-- Propósito: POST /customers responde 201 con el cliente creado y el estado HTTP definido por el flujo.
	     Escenario: cuerpo válido; Oracle (mock) acepta el insert. Resultado esperado: 201 con el id y el nombre. -->
	<munit:test name="apiCreateCustomer_whenBodyIsValid_thenReturn201"
		description="POST /customers responde 201 con el cliente creado">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="sapi-oracle-core-tih-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when processor="db:insert">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="db-insert-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/java --- { affectedRows: 1 }]" mediaType="application/java"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<http:request method="POST" config-ref="test-api-client" path="/api/v1/core/store/customers">
				<http:body><![CDATA[#[output application/json --- { id: '3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c', name: 'Ana', lastName: 'Pérez', email: 'ana.perez@example.com', phone: '+5215512345678', creationDate: '2026-10-07T16:30:00Z' }]]]></http:body>
				<http:headers><![CDATA[#[{ client_id: 'test-id', client_secret: 'test-secret', 'Content-Type': 'application/json' }]]]></http:headers>
				<http:response-validator>
					<http:success-status-code-validator values="0..599"/>
				</http:response-validator>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[attributes.statusCode]" is="#[MunitTools::equalTo(201)]"/>
			<munit-tools:assert-that expression="#[payload.id]" is="#[MunitTools::equalTo('3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c')]"/>
			<munit-tools:assert-that expression="#[payload.name]" is="#[MunitTools::equalTo('Ana')]"/>
		</munit:validation>
	</munit:test>


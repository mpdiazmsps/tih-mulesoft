	<!-- Propósito: POST /orders responde 201 con el Order y su total.
	     Escenario: pedido nuevo con 2 líneas; Oracle (mock) acepta el insert masivo. Resultado esperado: 201, total 2609.95. -->
	<munit:test name="apiCreateOrder_whenOrderIsNew_thenReturn201WithTotal"
		description="POST /orders responde 201 con el pedido y su total">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="sapi-oracle-core-tih-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when processor="db:select">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="db-select-order-exists"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/java --- [{ TOTAL: 0 }]]" mediaType="application/java"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="db:bulk-insert">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="db-bulk-insert-order-lines"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/java --- [1, 1]]" mediaType="application/java"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<http:request method="POST" config-ref="test-api-client" path="/api/v1/core/store/orders">
				<http:body><![CDATA[#[output application/json --- readUrl('classpath://payloads/order-create-request.json', 'application/json')]]]></http:body>
				<http:headers><![CDATA[#[{ client_id: 'test-id', client_secret: 'test-secret', 'Content-Type': 'application/json' }]]]></http:headers>
				<http:response-validator>
					<http:success-status-code-validator values="0..599"/>
				</http:response-validator>

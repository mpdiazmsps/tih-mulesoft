	<!-- Propósito: POST /customers valida el cuerpo contra el RAML.
	     Escenario: correo con formato inválido. Resultado esperado: 400 y Oracle no se invoca. -->
	<munit:test name="apiCreateCustomer_whenEmailIsInvalid_thenReturn400"
		description="POST /customers con email inválido responde 400">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="sapi-oracle-core-tih-main"/>
		</munit:enable-flow-sources>
		<munit:execution>
			<http:request method="POST" config-ref="test-api-client" path="/api/v1/core/store/customers">
				<http:body><![CDATA[#[output application/json --- { id: '3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c', name: 'Ana', email: 'no-es-un-correo', creationDate: '2026-10-07T16:30:00Z' }]]]></http:body>
				<http:headers><![CDATA[#[{ client_id: 'test-id', client_secret: 'test-secret', 'Content-Type': 'application/json' }]]]></http:headers>
				<http:response-validator>
					<http:success-status-code-validator values="0..599"/>
				</http:response-validator>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[attributes.statusCode]" is="#[MunitTools::equalTo(400)]"/>
			<munit-tools:assert-that expression="#[payload.code]" is="#[MunitTools::equalTo('VALIDATION_ERROR')]"/>
			<munit-tools:verify-call processor="db:insert" times="0"/>

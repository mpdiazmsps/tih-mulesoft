# Copia como credentials.local (ignorado por Git) y cambia las claves.
# ORACLE_PWD: clave de SYS y SYSTEM.
# APP_USER / APP_USER_PASSWORD: esquema del ERP (STORE_APP). Lo usa solo sapi-oracle-core.
# INT_USER / INT_USER_PASSWORD: almacén de solicitudes (INTEGRATION_APP). Lo usa solo papi-order-requests.
# Estas claves de ejemplo solo sirven en local. Antes de abrir los túneles para CloudHub,
# infra/tunnels/rotate-cloud-secrets las cambia por claves fuertes (D21).
ORACLE_PWD=CambiaEstaClave_1
APP_USER=STORE_APP
APP_USER_PASSWORD=CambiaEstaClave_2
INT_USER=INTEGRATION_APP
INT_USER_PASSWORD=CambiaEstaClave_3

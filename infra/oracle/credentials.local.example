# Copia como credentials.local (ignorado por Git) y cambia las claves.
# ORACLE_PWD: clave de SYS y SYSTEM. APP_USER/APP_USER_PASSWORD: usuario de la aplicación que se crea al primer arranque.
# Usa las mismas APP_USER y APP_USER_PASSWORD en db.user y db.password de sapi-oracle-core-tih.
ORACLE_PWD=CambiaEstaClave_1
APP_USER=STORE_APP
APP_USER_PASSWORD=CambiaEstaClave_2

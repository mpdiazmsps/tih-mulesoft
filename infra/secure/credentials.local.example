# Copia como credentials.local (ignorado por Git).
# Clave con la que las apps descifran sus *-secure-application-config.yaml (AES/CBC, 16 caracteres).
# Se pasa a cada app como VM argument: -M-Dencryption.key=<ENCRYPTION_KEY>
# Si dejas los valores de esos archivos en claro, cualquier clave de 16 caracteres sirve.
ENCRYPTION_KEY=CambiaEsta16Chrs
ALGORITHM=AES
MODE=CBC

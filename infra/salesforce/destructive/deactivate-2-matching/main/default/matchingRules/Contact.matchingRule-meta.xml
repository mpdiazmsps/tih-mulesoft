<?xml version="1.0" encoding="UTF-8"?>
<MatchingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <matchingRules>
        <fullName>POC_Email_Exacto</fullName>
        <description>PoC (D22): dos contactos coinciden si tienen el mismo correo exacto.</description>
        <label>POC Email exacto</label>

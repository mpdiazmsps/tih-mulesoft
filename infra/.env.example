# Opcional. Copia como infra/.env solo si necesitas cambiar un puerto porque ya está ocupado en tu equipo.
# Los valores por defecto no chocan con la base (oracle-store 1521, tih-oracle 1522, tih-rabbitmq 5672/15672, Rebex 2222).
# Si cambias un puerto, cambia también el de la configuración local de las apps que lo usan.
ORACLE_PORT=1523
RABBITMQ_PORT=5673
RABBITMQ_CONSOLE_PORT=15673
SFTP_PORT=2223
WIREMOCK_PORT=8089

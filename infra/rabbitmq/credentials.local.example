# Copia como credentials.local (ignorado por Git) y cambia las claves.
# infra/scripts/start-infra crea estos dos usuarios en poc-rabbitmq (y les cambia la clave si ya existen).
# Admin: consola web http://localhost:15673. App: lo usan papi-orders, papi-order-requests y papi-notifications.
# Estas claves solo sirven en local; antes de abrir los túneles, rotate-cloud-secrets las cambia (D21).
RABBITMQ_ADMIN_USER=poc-admin
RABBITMQ_ADMIN_PASSWORD=CambiaEstaClave_4
RABBITMQ_APP_USER=poc-app
RABBITMQ_APP_PASSWORD=CambiaEstaClave_5

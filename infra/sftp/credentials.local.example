# Copia como credentials.local (ignorado por Git) y cambia la clave.
# SFTP_USERS lo lee el contenedor tih-sftp con el formato usuario:clave:uid. El usuario debe ser tihsftp.
# Usa el mismo usuario y clave en sftp.user y sftp.password de sapi-sftp-orders-tih.
SFTP_USER=tihsftp
SFTP_PASSWORD=CambiaEstaClave_5
SFTP_USERS=tihsftp:CambiaEstaClave_5:1001

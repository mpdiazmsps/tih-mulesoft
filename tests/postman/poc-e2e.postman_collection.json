    {
      "name": "E1 Qué requiere mi atención",
      "description": "Escena 1: la bandeja de pedidos en riesgo, primero los clientes estratégicos. La tienda (xapi) y el agente (MCP) ven la misma lista.",
      "item": [
        {
          "name": "Pedidos en riesgo (tienda)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('menos de 3 s', () => pm.expect(pm.response.responseTime).to.be.below(3000));",
                  "const b = pm.response.json();",
                  "pm.test('bandeja en orden: 1002, 1004, 1001, 1005', () => pm.expect(b.map(e => e.orderId.slice(-4))).to.eql(['1002', '1004', '1001', '1005']));",
                  "pm.test('tipos de excepción', () => pm.expect(b.map(e => e.type)).to.eql(['STOCK_SHORTAGE', 'DISPATCH_REJECTED', 'UNCONFIRMED', 'STOCK_SHORTAGE']));",
                  "pm.test('estratégicos primero', () => pm.expect(b.map(e => e.customer.segment)).to.eql(['STRATEGIC', 'STRATEGIC', 'REGULAR', 'REGULAR']));",
                  "pm.test('PED-1003 no aparece (sin excepción)', () => pm.expect(b.map(e => e.orderId)).to.not.include('10000000-0000-4000-8000-000000001003'));",
                  "pm.test('PED-1004: Dirección incorrecta', () => pm.expect(b[1].detail).to.eql('Dirección incorrecta'));",
                  "pm.environment.set('e2eInbox', JSON.stringify(b.map(e => e.orderId)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "client_id",
                "value": "{{storeClientId}}"
              },
              {
                "key": "client_secret",
                "value": "{{clientSecret}}"
              },
              {
                "key": "x-correlation-id",
                "value": "e2e-{{$guid}}"
              }
            ],
            "url": "{{xapiUrl}}/orders/exceptions"
          }
        },
        {
          "name": "Agente: abre sesión MCP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('servidor mcp-online-store', () => pm.expect(pm.response.json().result.serverInfo.name).to.eql('mcp-online-store'));",
                  "const sid = pm.response.headers.get('mcp-session-id');",
                  "pm.test('sesión MCP', () => pm.expect(sid).to.be.a('string').and.not.empty);",
                  "pm.environment.set('mcpSessionId', sid);"
                ]
              }
            }
          ],

    {
      "name": "E3 Y si un sistema falla",
      "description": "Escena 3. Correr después de demo/control slow-c y sftp-down: la respuesta llega a tiempo y dice qué le falta. Una sola consulta por canal, para no abrir los circuitos.",
      "item": [
        {
          "name": "Pedido 360 de PED-1002 con logística caída y C lento (tienda)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('menos de 3 s', () => pm.expect(pm.response.responseTime).to.be.below(3000));",
                  "const o = pm.response.json();",
                  "pm.test('ERP y CRM responden', () => { pm.expect(o.sources.erp).to.eql('OK'); pm.expect(o.sources.crm).to.eql('OK'); });",
                  "pm.test('logística no disponible y la remisión desconocida', () => { pm.expect(o.sources.logistics).to.eql('UNAVAILABLE'); pm.expect(o.dispatchNote.status).to.eql('UNKNOWN'); });",
                  "pm.test('2 de 3 cotizaciones (falta C)', () => { pm.expect(o.sources.providers).to.eql('2 of 3'); pm.expect(o.alternatives.map(a => a.provider)).to.not.include('BOR'); });",
                  "pm.test('el resto del pedido llega completo', () => { pm.expect(o.customer.name).to.eql('Constructora Cumbres'); pm.expect(o.lines[0].available).to.eql(2); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "client_id",
                "value": "{{storeClientId}}"
              },
              {
                "key": "client_secret",
                "value": "{{clientSecret}}"
              },
              {
                "key": "x-correlation-id",
                "value": "e2e-{{$guid}}"
              }
            ],
            "url": "{{xapiUrl}}/orders/10000000-0000-4000-8000-000000001002"
          }
        },
        {
          "name": "Agente: get_order PED-1002 con las fallas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rpc = pm.response.json();",
                  "pm.test('JSON-RPC sin error', () => pm.expect(rpc.error, JSON.stringify(rpc.error)).to.be.undefined);",
                  "const result = rpc.result || {};",
                  "const tool = result.content && result.content[0] ? JSON.parse(result.content[0].text) : null;",
                  "pm.test('el agente ve lo mismo: qué falta', () => { pm.expect(tool.sources.logistics).to.eql('UNAVAILABLE'); pm.expect(tool.sources.providers).to.eql('2 of 3'); });"
                ]
              }
            }
          ],

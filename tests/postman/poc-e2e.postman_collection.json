    {
      "name": "E2a Qué hago con este pedido",
      "description": "Escena 2: el Pedido 360 de PED-1002 compuesto al consultar, con las tres cotizaciones y la de C (BOR) como la más barata.",
      "item": [
        {
          "name": "Pedido 360 de PED-1002 (tienda)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('menos de 3 s', () => pm.expect(pm.response.responseTime).to.be.below(3000));",
                  "const o = pm.response.json();",
                  "pm.test('PED-1002 confirmado, de Constructora Cumbres', () => { pm.expect(o.status).to.eql('CONFIRMED'); pm.expect(o.customer.name).to.eql('Constructora Cumbres'); });",
                  "pm.test('SKU-100: pide 5, hay 2', () => { pm.expect(o.lines[0].sku).to.eql('SKU-100'); pm.expect(o.lines[0].ordered).to.eql(5); pm.expect(o.lines[0].available).to.eql(2); });",
                  "pm.test('remisión en espera', () => pm.expect(o.dispatchNote.status).to.eql('ON_HOLD'));",
                  "pm.test('faltante de inventario', () => pm.expect(o.exceptions).to.include('STOCK_SHORTAGE'));",
                  "const q = Object.fromEntries(o.alternatives.map(a => [a.provider, a.price]));",
                  "pm.test('3 cotizaciones: A 189, B 194, C 175', () => pm.expect(q).to.eql({ FAK: 189, ESC: 194, BOR: 175 }));",
                  "pm.test('C (BOR) la más barata', () => pm.expect(o.alternatives.find(a => a.cheapest).provider).to.eql('BOR'));",
                  "pm.test('todas las fuentes respondieron', () => pm.expect(o.sources).to.eql({ erp: 'OK', crm: 'OK', logistics: 'OK', providers: '3 of 3' }));",
                  "pm.test('segmento STRATEGIC, leído de Salesforce al consultar', () => pm.expect(pm.response.json().customer.segment).to.eql('STRATEGIC'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "client_id",
                "value": "{{storeClientId}}"
              },
              {
                "key": "client_secret",

      "item": [
        {
          "name": "Los 5 pedidos del guion",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('5 pedidos', () => pm.expect(b.length).to.eql(5));",
                  "const st = Object.fromEntries(b.map(o => [o.orderId.slice(-4), o.status]));",
                  "pm.test('estados del guion', () => pm.expect(st).to.eql({ '1001': 'RECEIVED', '1002': 'CONFIRMED', '1003': 'CONFIRMED', '1004': 'CONFIRMED', '1005': 'CONFIRMED' }));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "client_id",
                "value": "{{clientId}}"
              },
              {
                "key": "client_secret",
                "value": "{{clientSecret}}"
              },
              {
                "key": "x-correlation-id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{sapiOracleCoreUrl}}/orders",
              "host": [
                "{{sapiOracleCoreUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          }

<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
	xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

	<!-- Pruebas unitarias de notifications-process-order-registered-flow: papi-customers y sapi-magicbell se simulan por doc:name. -->
	<munit:config name="notify-order-registered-test.xml"/>

	<!-- Propósito: cliente con email recibe el correo. Escenario: papi-customers devuelve email y sapi-magicbell acepta.
	     Resultado esperado: SENT y la NotificationRequest lleva email, orderId y el nombre en el contenido. -->
	<munit:test name="notify_whenCustomerHasEmail_thenSendAndReturnSent">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-get-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{ id: 'c-1', name: 'Ana', email: 'ana.perez@example.com' }]" mediaType="application/java"/>
					<munit-tools:attributes value="#[{ statusCode: 200 }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-send-notification"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{ id: 'bc-1' }]" mediaType="application/java"/>
					<munit-tools:attributes value="#[{ statusCode: 201 }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:spy processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-send-notification"/>
				</munit-tools:with-attributes>
				<munit-tools:before-call>
					<munit-tools:assert-that expression="#[payload.broadcast.recipients[0].email]" is="#[MunitTools::equalTo('ana.perez@example.com')]"/>
					<munit-tools:assert-that expression="#[payload.broadcast.custom_attributes.orderId]" is="#[MunitTools::equalTo('o-1')]"/>
					<munit-tools:assert-that expression="#[payload.broadcast.content]" is="#[MunitTools::containsString('Ana')]"/>
					<munit-tools:assert-that expression="#[payload.broadcast.content]" is="#[MunitTools::containsString('2500.00')]"/>
				</munit-tools:before-call>
			</munit-tools:spy>
			<munit:set-event>
				<munit:payload value="#[{ eventType: 'order.registered', orderId: 'o-1', customerId: 'c-1', total: 2500 }]" mediaType="application/java"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="notifications-process-order-registered-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[payload.orderId]" is="#[MunitTools::equalTo('o-1')]"/>
			<munit-tools:assert-that expression="#[payload.status]" is="#[MunitTools::equalTo('SENT')]"/>
			<munit-tools:verify-call processor="http:request" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-send-notification"/>
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>

	<!-- Propósito: cliente sin email no genera correo. Escenario: papi-customers devuelve el cliente solo con teléfono.
	     Resultado esperado: SKIPPED_NO_EMAIL y sapi-magicbell no se llama. -->
	<munit:test name="notify_whenCustomerHasNoEmail_thenSkip">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-get-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{ id: 'c-1', name: 'Ana', phone: '+5215512345678' }]" mediaType="application/java"/>
					<munit-tools:attributes value="#[{ statusCode: 200 }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:payload value="#[{ eventType: 'order.registered', orderId: 'o-2', customerId: 'c-1', total: 10 }]" mediaType="application/java"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="notifications-process-order-registered-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[payload.orderId]" is="#[MunitTools::equalTo('o-2')]"/>
			<munit-tools:assert-that expression="#[payload.status]" is="#[MunitTools::equalTo('SKIPPED_NO_EMAIL')]"/>
			<munit-tools:verify-call processor="http:request" times="0">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-send-notification"/>
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>

	<!-- Propósito: cliente inexistente es un error de negocio. Escenario: papi-customers responde 404.
	     Resultado esperado: APP:CUSTOMER_NOT_FOUND. -->
	<munit:test name="notify_whenCustomerNotFound_thenCustomerNotFoundError" expectedErrorType="APP:CUSTOMER_NOT_FOUND">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-get-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{ code: 'CUSTOMER_NOT_FOUND' }]" mediaType="application/java"/>
					<munit-tools:attributes value="#[{ statusCode: 404 }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:payload value="#[{ eventType: 'order.registered', orderId: 'o-3', customerId: 'c-x', total: 10 }]" mediaType="application/java"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="notifications-process-order-registered-flow"/>
		</munit:execution>
	</munit:test>

	<!-- Propósito: la falla de sapi-magicbell sube sin enmascararse. Escenario: sapi-magicbell responde 503.
	     Resultado esperado: HTTP:SERVICE_UNAVAILABLE para que el manejador global o el reintento AMQP actúen. -->
	<munit:test name="notify_whenMagicBellUnavailable_thenPropagateError" expectedErrorType="HTTP:SERVICE_UNAVAILABLE">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-get-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{ id: 'c-1', name: 'Ana', email: 'ana.perez@example.com' }]" mediaType="application/java"/>
					<munit-tools:attributes value="#[{ statusCode: 200 }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-send-notification"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="HTTP:SERVICE_UNAVAILABLE"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:payload value="#[{ eventType: 'order.registered', orderId: 'o-4', customerId: 'c-1', total: 10 }]" mediaType="application/java"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="notifications-process-order-registered-flow"/>
		</munit:execution>
	</munit:test>

	<!-- Propósito: MagicBell rechaza el destinatario o el contenido. Escenario: MagicBell responde 422 (el conector HTTP no tiene tipo de error para 422).
	     Resultado esperado: APP:NOTIFICATION_REJECTED. -->
	<munit:test name="notify_whenMagicBellRespondsUnprocessable_thenNotificationRejected" expectedErrorType="APP:NOTIFICATION_REJECTED">
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-get-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{ id: 'c-1', name: 'Ana', email: 'ana.perez@example.com' }]" mediaType="application/java"/>
					<munit-tools:attributes value="#[{ statusCode: 200 }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-send-notification"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{ errors: [{ message: 'invalid recipient' }] }]" mediaType="application/java"/>
					<munit-tools:attributes value="#[{ statusCode: 422 }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event>
				<munit:payload value="#[{ eventType: 'order.registered', orderId: 'o-5', customerId: 'c-1', total: 10 }]" mediaType="application/java"/>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="notifications-process-order-registered-flow"/>
		</munit:execution>
	</munit:test>

</mule>

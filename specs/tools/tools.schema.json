{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mcp-online-store tools contract",
  "description": "Shape of specs/mcp-online-store/tools.yaml: the server and its five business tools. No tool approves or applies.",
  "type": "object",
  "required": ["server", "tools"],
  "additionalProperties": false,
  "properties": {
    "server": {
      "type": "object",
      "required": ["name", "version", "description", "transport", "path"],
      "additionalProperties": false,
      "properties": {
        "name": { "const": "mcp-online-store" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "description": { "type": "string", "minLength": 20 },
        "transport": { "const": "streamable-http" },
        "path": { "const": "/mcp" },
        "access": { "type": "string" },
        "dependsOn": { "type": "array", "items": { "type": "string", "pattern": "^papi-" } }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/definitions/tool" }
    }
  },
  "definitions": {
    "tool": {
      "type": "object",
      "required": ["name", "title", "description", "access", "annotations", "inputSchema", "calls"],
      "additionalProperties": false,
      "properties": {
        "name": { "enum": ["get_order", "list_exceptions", "propose_alternatives", "request_correction", "get_request"] },
        "title": { "type": "string", "minLength": 3 },
        "description": { "type": "string", "minLength": 30 },
        "access": { "enum": ["read-only", "requests-only"] },
        "annotations": {
          "type": "object",
          "required": ["readOnlyHint", "destructiveHint"],
          "additionalProperties": false,
          "properties": {
            "readOnlyHint": { "type": "boolean" },
            "destructiveHint": { "const": false },
            "idempotentHint": { "type": "boolean" },
            "openWorldHint": { "type": "boolean" }
          }
        },
        "inputSchema": {
          "type": "object",
          "required": ["type", "properties"],
          "properties": {
            "type": { "const": "object" },
            "properties": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["type", "description"],
                "properties": { "description": { "type": "string", "minLength": 5 } }
              }
            },
            "required": { "type": "array", "items": { "type": "string" } },
            "additionalProperties": { "const": false }
          }
        },
        "idempotencyKey": { "type": "string" },
        "idempotencyNote": { "type": "string" },
        "calls": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^(GET|POST) papi-(orders|order-requests) /" }
        }
      }
    }
  }
}

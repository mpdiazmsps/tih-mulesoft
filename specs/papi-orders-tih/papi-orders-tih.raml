#%RAML 1.0
title: papi-orders-tih
version: v1
baseUri: http://localhost:8083/api/v1/orders-management
protocols: [HTTP]
mediaType: application/json
description: |
  Process API de pedidos.
  - Recibe pedidos: valida el cliente, genera el orderId y deposita el CSV en el SFTP.
  - Procesa los pedidos pendientes: un scheduler interno (frecuencia configurable) o el disparo manual
    de POST /orders/process leen los CSV, resuelven precios (tienda o proveedor), registran el pedido en Oracle
    y publican el evento order.registered en RabbitMQ. Evita reprocesar un pedido ya registrado.

uses:
  types: ../fragments/tih-common-types.raml
  traits: ../fragments/tih-common-traits.raml

/orders:
  post:
    displayName: Recibir pedido
    description: |
      Valida que el cliente esté registrado, genera el orderId y deposita el archivo
      <customerId>_<orderId>.csv (columnas item,qty) en /orders/pending del SFTP.
    is: [traits.secured, traits.validated, traits.not-found, traits.retryable]
    body:
      application/json:
        type: types.OrderRequest
    responses:
      201:
        description: Pedido recibido.
        body:
          application/json:
            type: types.OrderReceived

  /process:
    post:
      displayName: Procesar pedidos pendientes
      description: |
        Dispara manualmente el mismo procesamiento que ejecuta el scheduler (útil para la demostración).
        Responde de inmediato y el procesamiento continúa en segundo plano.
        Si ya hay un ciclo en curso responde 409 PROCESS_ALREADY_RUNNING.
      is: [traits.secured, traits.conflict]
      responses:
        202:
          description: Procesamiento iniciado.
          body:
            application/json:
              type: types.ProcessResult
              example:
                status: ACCEPTED
                message: Procesamiento de pedidos pendientes iniciado

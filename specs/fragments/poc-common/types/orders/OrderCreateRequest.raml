#%RAML 1.0 DataType
description: A new order with header and lines. The order is born RECEIVED.
type: object
properties:
  orderId:
    type: !include ../identifiers/Uuid.raml
    description: Generated by papi-orders. Repeating it returns 409.
  customerId: !include ../identifiers/SalesforceId.raml
  currency: !include ../identifiers/Currency.raml
  lines:
    type: array
    items: !include OrderLineRequest.raml
    minItems: 1
    maxItems: 100
example:
  orderId: 10000000-0000-4000-8000-000000001002
  customerId: 003Hs00000CUMBRAAA
  currency: MXN
  lines:
    - itemId: 20000000-0000-4000-8000-000000000100
      quantity: 5

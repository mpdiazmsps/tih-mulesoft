#%RAML 1.0 DataType
description: |
  The order seen from every source: ERP, CRM, logistics and providers.
  If a source does not answer, the response still arrives and flags it in sources.
type: object
properties:
  orderId: !include ../identifiers/Uuid.raml
  status: !include ../catalogs/OrderStatus.raml
  currency: !include ../identifiers/Currency.raml
  createdAt: datetime
  customer:
    type: !include ../customers/CustomerSummary.raml
    required: false
    description: Missing when the CRM did not answer.
  lines:
    type: array
    items:
      type: object
      properties:
        itemId: !include ../identifiers/Uuid.raml
        sku: string
        ordered:
          type: integer
          description: Quantity ordered.
        available:
          type: integer
          description: Stock available in the ERP.
        unitPrice:
          type: number
          required: false
  dispatchNote:
    type: object
    properties:
      dispatchNoteId:
        type: string
        required: false
      status: !include ../catalogs/DispatchStatus.raml
      reason:
        type: string
        required: false
  exceptions:
    type: array
    items: !include ../catalogs/ExceptionType.raml
  alternatives:
    type: array
    items: !include Alternative.raml
  sources: !include Sources.raml
example:
  orderId: 10000000-0000-4000-8000-000000001002
  status: CONFIRMED
  currency: MXN
  createdAt: 2026-11-20T09:15:00-06:00
  customer:
    id: 003Hs00000CUMBRAAA
    name: Constructora Cumbres
    segment: STRATEGIC
    city: Monterrey
  lines:
    - itemId: 20000000-0000-4000-8000-000000000100
      sku: SKU-100
      ordered: 5
      available: 2
      unitPrice: 189.00
  dispatchNote:
    status: ON_HOLD
  exceptions: [STOCK_SHORTAGE]
  alternatives:
    - type: RESTOCK
      itemId: 20000000-0000-4000-8000-000000000100
      sku: SKU-100
      quantity: 3
      provider: BOR
      price: 175.00
      currency: MXN
      cheapest: true
  sources:
    erp: OK
    crm: OK
    logistics: OK
    providers: 3 of 3

#%RAML 1.0 DataType
description: |
  Stock outbound or restock. The reference is the idempotency key:
  repeating it returns the existing movement without moving the stock again.
type: object
properties:
  itemId: !include ../identifiers/Uuid.raml
  type:
    type: string
    enum: [OUTBOUND, RESTOCK]
  quantity:
    type: integer
    minimum: 1
  reference:
    type: string
    minLength: 1
    maxLength: 100
    description: Unique key of the movement, for example the idempotency key of the correction request.
  orderId:
    type: !include ../identifiers/Uuid.raml
    required: false
example:
  itemId: 20000000-0000-4000-8000-000000000100
  type: RESTOCK
  quantity: 3
  reference: 7f3c2a10-9b4e-4c1d-8e2f-5a6b7c8d9e0f
  orderId: 10000000-0000-4000-8000-000000001002

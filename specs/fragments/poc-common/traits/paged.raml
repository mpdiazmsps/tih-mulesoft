#%RAML 1.0 Trait
description: Paged listing. The first page is 1.
queryParameters:
  page:
    description: Page number, starting at 1.
    type: integer
    minimum: 1
    default: 1
    required: false
    example: 1
  size:
    description: Items per page.
    type: integer
    minimum: 1
    maximum: 100
    default: 20
    required: false
    example: 20

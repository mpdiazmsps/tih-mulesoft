#%RAML 1.0 Trait
description: The request may conflict with the current state of the resource.
responses:
  409:
    description: Conflict with the current state. Nothing was changed.
    body:
      application/json:
        type: !include ../types/errors/ErrorResponse.raml
        example:
          code: INSUFFICIENT_STOCK
          message: The outbound movement would leave the stock negative
          correlationId: 0b6f2f0e-4a0c-4d25-9a4c-3d9e6a7b1c2d
          timestamp: 2026-11-20T12:00:00-06:00
          retryable: false

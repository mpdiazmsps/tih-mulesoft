#%RAML 1.0
title: papi-notifications-tih
version: v1
baseUri: http://localhost:8084/api/v1/notifications
protocols: [HTTP]
mediaType: application/json
description: |
  Process API de notificaciones.
  Su disparador principal es un listener AMQP sobre la cola orders.registered.q (ACK manual), que no aparece
  en este contrato porque no es HTTP. Para cada evento order.registered obtiene el correo del cliente,
  arma el mensaje y lo envía directamente a MagicBell (POST /broadcasts con token Bearer). Si el cliente no tiene email, omite la notificación.
  El recurso HTTP permite reenviar manualmente una notificación.

uses:
  types: ../fragments/tih-common-types.raml
  traits: ../fragments/tih-common-traits.raml

/orders-registered:
  post:
    displayName: Notificar pedido registrado
    description: Procesa un evento order.registered y envía el correo al cliente (reenvío manual).
    is: [traits.secured, traits.validated, traits.not-found, traits.bad-gateway, traits.retryable]
    body:
      application/json:
        type: types.OrderRegisteredEvent
    responses:
      200:
        description: Evento procesado. El estado indica si se envió el correo o se omitió.
        body:
          application/json:
            type: types.NotificationResult

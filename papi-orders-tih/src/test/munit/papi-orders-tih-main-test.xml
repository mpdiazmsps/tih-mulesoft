<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:os="http://www.mulesoft.org/schema/mule/os"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
	xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
		http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd
		http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

	<!-- Pruebas HTTP: listener real en el puerto 8083 (debe estar libre) con las APIs de las que depende simuladas.
	     Cubren APIkit, el catalogo de errores y los headers de la respuesta. -->
	<munit:config name="papi-orders-tih-main-test.xml"/>

	<http:request-config name="test-api-client" doc:name="HTTP Request configuration">
		<http:request-connection host="localhost" port="8083"/>
	</http:request-config>

	<!-- El candado vive en memoria dentro de la app de pruebas: se limpia antes y despues de cada prueba. -->
	<!-- Ningún test debe publicar en el RabbitMQ real: amqp:publish también se simula antes de cada prueba. -->
	<munit:before-test name="lock-clean-before">
		<munit-tools:mock-when processor="amqp:publish">
			<munit-tools:then-return>
				<munit-tools:payload value="#['published']" mediaType="application/java"/>
			</munit-tools:then-return>
		</munit-tools:mock-when>
		<try><os:remove key="processing" objectStore="process-lock-store"/><error-handler><on-error-continue/></error-handler></try>
	</munit:before-test>
	<munit:after-test name="lock-clean-after">
		<try><os:remove key="processing" objectStore="process-lock-store"/><error-handler><on-error-continue/></error-handler></try>
	</munit:after-test>

	<!-- APIkit arma su tabla de rutas con los flujos ya inicializados (MUnit los inicia de forma perezosa).
	     El flujo de disparo real arrancaria un ciclo contra las APIs: se simula mientras se calienta. -->
	<munit:before-suite name="main-warm-up">
		<munit-tools:mock-when processor="mule:flow-ref">
			<munit-tools:with-attributes>
				<munit-tools:with-attribute attributeName="name" whereValue="orders-process-trigger-flow"/>
			</munit-tools:with-attributes>
			<munit-tools:then-return>
				<munit-tools:payload value="#[{}]" mediaType="application/java"/>
			</munit-tools:then-return>
		</munit-tools:mock-when>
		<try><flow-ref name="post:\orders:application\json:papi-orders-tih-config"/><error-handler><on-error-continue/></error-handler></try>
		<try><flow-ref name="post:\orders\process:papi-orders-tih-config"/><error-handler><on-error-continue/></error-handler></try>
	</munit:before-suite>

	<flow name="test-http-post-order-flow">
		<http:request method="POST" config-ref="test-api-client" path="/api/v1/orders-management/orders">
			<http:body>#[vars.testBody]</http:body>
			<http:headers><![CDATA[#[{ client_id: 'test-id', client_secret: 'test-secret', 'Content-Type': 'application/json' }]]]></http:headers>
			<http:response-validator>
				<http:success-status-code-validator values="0..599"/>
			</http:response-validator>
		</http:request>
	</flow>

	<flow name="test-http-process-flow">
		<http:request method="POST" config-ref="test-api-client" path="/api/v1/orders-management/orders/process">
			<http:headers><![CDATA[#[{ client_id: 'test-id', client_secret: 'test-secret' }]]]></http:headers>
			<http:response-validator>
				<http:success-status-code-validator values="0..599"/>
			</http:response-validator>
		</http:request>
	</flow>

	<!-- Proposito: POST /orders responde 201. Escenario: cliente existente y SFTP disponible. Resultado esperado: 201 y OrderReceived. -->
	<munit:test name="apiPostOrder_whenValid_thenReturn201">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="papi-orders-tih-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-get-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{ id: '3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c' }]" mediaType="application/java"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-put-order-file"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{ status: 'pending' }]" mediaType="application/java"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<set-variable variableName="testBody" value="#['{&quot;customerId&quot;:&quot;3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c&quot;,&quot;items&quot;:[{&quot;itemId&quot;:&quot;c1a2b3c4-d5e6-4789-a012-3456789abc01&quot;,&quot;quantity&quot;:2}]}']"/>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="test-http-post-order-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[attributes.statusCode]" is="#[MunitTools::equalTo(201)]"/>
			<munit-tools:assert-that expression="#[payload.status]" is="#[MunitTools::equalTo('RECEIVED')]"/>
			<munit-tools:assert-that expression="#[payload.customerId]" is="#[MunitTools::equalTo('3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c')]"/>
		</munit:validation>
	</munit:test>

	<!-- Proposito: cliente inexistente responde 404. Resultado esperado: 404 CUSTOMER_NOT_FOUND. -->
	<munit:test name="apiPostOrder_whenCustomerNotFound_thenReturn404">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="papi-orders-tih-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-get-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{ code: 'CUSTOMER_NOT_FOUND' }]" mediaType="application/java"/>
					<munit-tools:attributes value="#[{ statusCode: 404 }]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<set-variable variableName="testBody" value="#['{&quot;customerId&quot;:&quot;3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c&quot;,&quot;items&quot;:[{&quot;itemId&quot;:&quot;c1a2b3c4-d5e6-4789-a012-3456789abc01&quot;,&quot;quantity&quot;:2}]}']"/>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="test-http-post-order-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[attributes.statusCode]" is="#[MunitTools::equalTo(404)]"/>
			<munit-tools:assert-that expression="#[payload.code]" is="#[MunitTools::equalTo('CUSTOMER_NOT_FOUND')]"/>
			<munit-tools:assert-that expression="#[payload.retryable]" is="#[MunitTools::equalTo(false)]"/>
		</munit:validation>
	</munit:test>

	<!-- Proposito: articulo repetido responde 400. Resultado esperado: 400 VALIDATION_ERROR. -->
	<munit:test name="apiPostOrder_whenDuplicateItems_thenReturn400">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="papi-orders-tih-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<set-variable variableName="testBody" value="#['{&quot;customerId&quot;:&quot;3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c&quot;,&quot;items&quot;:[{&quot;itemId&quot;:&quot;c1a2b3c4-d5e6-4789-a012-3456789abc01&quot;,&quot;quantity&quot;:2},{&quot;itemId&quot;:&quot;c1a2b3c4-d5e6-4789-a012-3456789abc01&quot;,&quot;quantity&quot;:1}]}']"/>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="test-http-post-order-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[attributes.statusCode]" is="#[MunitTools::equalTo(400)]"/>
			<munit-tools:assert-that expression="#[payload.code]" is="#[MunitTools::equalTo('VALIDATION_ERROR')]"/>
		</munit:validation>
	</munit:test>

	<!-- Proposito: APIkit valida el contrato. Escenario: customerId invalido y sin articulos. Resultado esperado: 400 VALIDATION_ERROR. -->
	<munit:test name="apiPostOrder_whenContractViolated_thenReturn400">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="papi-orders-tih-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<set-variable variableName="testBody" value="#['{&quot;customerId&quot;:&quot;nope&quot;,&quot;items&quot;:[]}']"/>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="test-http-post-order-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[attributes.statusCode]" is="#[MunitTools::equalTo(400)]"/>
			<munit-tools:assert-that expression="#[payload.code]" is="#[MunitTools::equalTo('VALIDATION_ERROR')]"/>
		</munit:validation>
	</munit:test>

	<!-- Proposito: SFTP caido responde 503 con Retry-After. Resultado esperado: 503 SERVICE_UNAVAILABLE, retryable y Retry-After 30. -->
	<munit:test name="apiPostOrder_whenSftpUnavailable_thenReturn503WithRetryAfter">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="papi-orders-tih-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-get-customer"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{ id: '3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c' }]" mediaType="application/java"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="http-request-put-order-file"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="HTTP:CONNECTIVITY"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<set-variable variableName="testBody" value="#['{&quot;customerId&quot;:&quot;3f2b8c1e-7a4d-4e5b-9c0a-1d2e3f4a5b6c&quot;,&quot;items&quot;:[{&quot;itemId&quot;:&quot;c1a2b3c4-d5e6-4789-a012-3456789abc01&quot;,&quot;quantity&quot;:2}]}']"/>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="test-http-post-order-flow"/>
			<set-variable variableName="retryAfter" value="#[attributes.headers.'retry-after']"/>
			<set-variable variableName="statusCode" value="#[attributes.statusCode]"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[vars.statusCode]" is="#[MunitTools::equalTo(503)]"/>
			<munit-tools:assert-that expression="#[payload.code]" is="#[MunitTools::equalTo('SERVICE_UNAVAILABLE')]"/>
			<munit-tools:assert-that expression="#[payload.retryable]" is="#[MunitTools::equalTo(true)]"/>
			<munit-tools:assert-that expression="#[vars.retryAfter]" is="#[MunitTools::equalTo('30')]"/>
		</munit:validation>
	</munit:test>

	<!-- Proposito: POST /orders/process responde 202 y una segunda llamada con el ciclo en curso responde 409. Escenario: el ciclo (simulado) mantiene el candado. Resultado esperado: 202 ACCEPTED y luego 409 PROCESS_ALREADY_RUNNING. -->
	<munit:test name="apiProcess_whenFree_thenReturn202ThenConflictWhileRunning">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="papi-orders-tih-main"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when processor="mule:flow-ref">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="name" whereValue="orders-process-pending-flow"/>
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{}]" mediaType="application/java"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<flow-ref name="test-http-process-flow"/>
			<set-variable variableName="firstStatus" value="#[attributes.statusCode]"/>
			<set-variable variableName="firstBody" value="#[payload.status]"/>
			<flow-ref name="test-http-process-flow"/>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that expression="#[vars.firstStatus]" is="#[MunitTools::equalTo(202)]"/>
			<munit-tools:assert-that expression="#[vars.firstBody]" is="#[MunitTools::equalTo('ACCEPTED')]"/>
			<munit-tools:assert-that expression="#[attributes.statusCode]" is="#[MunitTools::equalTo(409)]"/>
			<munit-tools:assert-that expression="#[payload.code]" is="#[MunitTools::equalTo('PROCESS_ALREADY_RUNNING')]"/>
		</munit:validation>
	</munit:test>

</mule>
